  .hero-bg { background: radial-gradient(ellipse 70% 60% at 15% 50%, rgba(242,164,19,.12) 0%, transparent 60%), radial-gradient(ellipse 50% 70% at 85% 20%, rgba(15,31,61,.06) 0%, transparent 55%), var(--paper); }
  .glass { background:rgba(255,255,255,.65); border:1.5px solid rgba(15,31,61,.22); backdrop-filter:blur(12px); box-shadow:0 2px 8px rgba(15,31,61,.06); }
