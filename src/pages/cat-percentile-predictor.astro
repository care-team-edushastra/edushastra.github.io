<script>
  import type { Session } from '@supabase/supabase-js'
  import { supabase } from '../lib/supabase'
  import { estimate } from '../data/catPercentile.js'

  type FormState = Record<string, string>

  // Typed, non-null element lookup (all ids exist in the markup above)
  const $ = <T extends HTMLElement = HTMLElement>(id: string) =>
    document.getElementById(id) as T
  const form = $<HTMLFormElement>('form')
  const avatar = $<HTMLImageElement>('avatar')
  const KEY = 'catPredictorForm'
  const PENDING = 'catPredictorPending'
  const KEYS = ['varc', 'lrdi', 'qa']
  const NAMES: Record<string, string> = { varc: 'VARC', lrdi: 'LRDI', qa: 'Quant' }
  const back = () => window.location.origin + window.location.pathname

  // Days to the exam (29 Nov 2026, IST)
  const days = Math.ceil((new Date('2026-11-29T00:00:00+05:30').getTime() - Date.now()) / 86400000)
  $('countdown').textContent = days > 1 ? 'CAT 2026 is in ' + days + ' days: Sunday, 29 November'
    : days === 1 ? 'CAT 2026 is tomorrow: Sunday, 29 November'
    : days === 0 ? 'CAT 2026 is today' : 'CAT 2026 is over. Predict your percentile now'

  // ---- account icon: profile when logged in, login otherwise ----
  function renderAccount(session: Session | null) {
    if (session) {
      const m = session.user.user_metadata || {}
      const name = m.full_name || m.name || 'Student'
      $('m-name').textContent = name
      $('m-email').textContent = session.user.email || ''
      $('initial').textContent = name.charAt(0).toUpperCase()
      if (m.avatar_url) { avatar.src = m.avatar_url; avatar.classList.remove('hidden'); $('initial').classList.add('hidden') }
      $('login-btn').classList.add('hidden'); $('profile-btn').classList.remove('hidden')
    } else {
      $('profile-btn').classList.add('hidden'); $('menu').classList.add('hidden')
      $('login-btn').classList.remove('hidden', 'invisible')
    }
  }
  supabase.auth.getSession().then(({ data }) => renderAccount(data.session))
  supabase.auth.onAuthStateChange((_e, session) => renderAccount(session))

  async function startLogin(gateError: boolean) {
    const { error } = await supabase.auth.signInWithOAuth({ provider: 'google', options: { redirectTo: back() } })
    if (error && gateError) $('gate-error').textContent = 'Could not start login. Please try again.'
  }
  $('login-btn').addEventListener('click', () => startLogin(false))
  $('profile-btn').addEventListener('click', () => {
    const open = $('menu').classList.toggle('hidden') === false
    $('profile-btn').setAttribute('aria-expanded', String(open))
  })
  document.addEventListener('click', (e) => { if (!$('account').contains(e.target as Node)) $('menu').classList.add('hidden') })
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') $('menu').classList.add('hidden') })
  $('logout').addEventListener('click', async () => {
    await supabase.auth.signOut()
    $('result').classList.add('hidden')
  })

  // ---- predictor ----
  const field = (k: string) => form.elements.namedItem(k) as HTMLInputElement | null
  const readForm = (): FormState => { const d: FormState = {}; new FormData(form).forEach((v, k) => { d[k] = String(v) }); return d }
  const fillForm = (d: FormState) => { Object.entries(d).forEach(([k, v]) => { const el = field(k); if (el) el.value = v }) }

  function validate(d: FormState) {
    if (!d.slot) return 'Please select your slot.'
    for (const k of KEYS) {
      if (d[k] === '' || d[k] === undefined) return 'Please fill in every field.'
      const n = Number(d[k]), max = Number(field(k)?.max)
      if (!Number.isInteger(n) || n < -15 || n > max)
        return NAMES[k] + ' marks must be a whole number between -15 and ' + max + '.'
    }
    return ''
  }

  // Marks are entered directly, so no attempted/correct conversion is needed.
  function score(d: FormState) {
    let total = 0
    const secs: Record<string, number> = {}
    for (const k of KEYS) { secs[k] = Number(d[k]); total += secs[k] }
    return { total, secs }
  }

  // Save the submission as a lead. A failure must never block the result.
  async function save(d: FormState, total: number, pcts: Record<string, number>) {
    try {
      await supabase.from('predictor_submissions').upsert({
        slot: Number(d.slot),
        varc_marks: Number(d.varc), lrdi_marks: Number(d.lrdi), qa_marks: Number(d.qa),
        total_score: total,
        overall_percentile: pcts.overall, varc_percentile: pcts.varc,
        lrdi_percentile: pcts.lrdi, qa_percentile: pcts.qa,
        updated_at: new Date().toISOString(),
      }, { onConflict: 'user_id' })
    } catch (x) {}
  }

  async function run(d: FormState) {
    const { data } = await supabase.auth.getSession()
    if (data.session) {
      const { total, secs } = score(d)
      const pcts: Record<string, number> = { overall: estimate(d.slot, 'overall', total) }
      for (const k of KEYS) pcts[k] = estimate(d.slot, k, secs[k])
      $('pct').textContent = pcts.overall.toFixed(2)
      $('total').textContent = String(total)
      const box = $('sections')
      box.textContent = ''
      for (const k of KEYS) {
        const card = document.createElement('div')
        card.className = 'rounded-xl border border-ink-100/15 p-3'
        const name = document.createElement('p'); name.className = 'text-xs font-semibold text-ink-200'; name.textContent = NAMES[k]
        const val = document.createElement('p'); val.className = 'font-display text-2xl font-bold text-ink-100'; val.textContent = pcts[k].toFixed(2)
        const sc = document.createElement('p'); sc.className = 'text-xs text-ink-200'; sc.textContent = 'Score ' + secs[k]
        card.append(name, val, sc)
        box.appendChild(card)
      }
      $('gate').classList.add('hidden')
      $('result').classList.remove('hidden')
      $('result').scrollIntoView({ behavior: 'smooth' })
      save(d, total, pcts)
    } else {
      $('result').classList.add('hidden')
      $('gate').classList.remove('hidden')
      $('gate').scrollIntoView({ behavior: 'smooth' })
    }
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault()
    const d = readForm()
    const err = validate(d)
    $('error').textContent = err
    if (err) return
    try { localStorage.setItem(KEY, JSON.stringify(d)) } catch (x) {}
    run(d)
  })

  $('google').addEventListener('click', () => {
    try { localStorage.setItem(PENDING, '1') } catch (x) {}
    startLogin(true)
  })

  // After the Google redirect, restore the saved answers and show the result.
  async function restore() {
    let saved: FormState | null = null
    try { saved = JSON.parse(localStorage.getItem(KEY) || 'null') } catch (x) {}
    if (!saved) return
    fillForm(saved)
    let pending = false
    try { pending = localStorage.getItem(PENDING) === '1' } catch (x) {}
    if (!pending) return
    const { data } = await supabase.auth.getSession()
    if (data.session) {
      try { localStorage.removeItem(PENDING) } catch (x) {}
      if (!validate(saved)) run(saved)
    }
  }
  restore()
</script>
<script is:inline>
  (() => {
    const mb = document.getElementById('menu-btn'), mm = document.getElementById('mobile-menu');
    if (mb && mm) mb.addEventListener('click', () => { const o = mm.classList.toggle('hidden') === false; mb.setAttribute('aria-expanded', String(o)); });
  })();
  document.querySelectorAll('.faq-btn').forEach(btn => btn.addEventListener('click', () => {
    const body = btn.nextElementSibling, open = !body.classList.contains('hidden');
    document.querySelectorAll('.faq-body').forEach(b => b.classList.add('hidden'));
    document.querySelectorAll('.faq-btn').forEach(b => { b.setAttribute('aria-expanded','false'); b.querySelector('.faq-icon').textContent = '+'; });
    if (!open) { body.classList.remove('hidden'); btn.setAttribute('aria-expanded','true'); btn.querySelector('.faq-icon').textContent = '\u2212'; }
  }));
</script>
</body>
