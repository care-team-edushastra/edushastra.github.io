            <label class="block text-xs font-medium text-ink-200">Attempted
              <input type="number" name={s.key + "_attempted"} min="0" max={s.max} required class={inputCls} />
            </label>
            <label class="mt-3 block text-xs font-medium text-ink-200">Expected correct
              <input type="number" name={s.key + "_correct"} min="0" max={s.max} required class={inputCls} />
