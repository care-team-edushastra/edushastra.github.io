    <p class="text-ink-200 text-center mt-3 max-w-2xl mx-auto">Approximate overall marks. Figures are estimates compiled from published analyses, vary by slot and source, and are not an official IIM table.</p>
    <div class="glass rounded-3xl overflow-hidden mt-8">
      <div class="overflow-x-auto">
        <table class="w-full text-sm min-w-[560px]">
          <caption class="sr-only">Approximate overall CAT marks for the 99th, 95th and 90th percentile, 2020 to 2025</caption>
          <thead><tr class="border-b border-white/10">
            <th scope="col" class="text-left px-5 py-4 font-display text-white">Percentile</th>
            {years.map(y => <th scope="col" class="text-left px-5 py-4 font-display text-white">CAT {y}</th>)}
          </tr></thead>
          <tbody>
            {rows.map(([label, ...vals]) => (
