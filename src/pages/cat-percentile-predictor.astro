---
const U = "https://www.edushastra.com";
const PAGE = `${U}/cat-percentile-predictor/`;
const TITLE = "CAT Percentile Predictor 2026 | Score vs Percentile | EduShastra";
const DESC = "Know your CAT 2026 percentile in seconds with EduShastra's free CAT percentile predictor. Get section-wise estimates and explore free CAT preparation resources.";
const sections = [
  { key: "varc", name: "VARC", max: 72 },
  { key: "lrdi", name: "LRDI", max: 66 },
  { key: "qa", name: "Quant (QA)", max: 66 },
];
const openSlots = [1];
const inputCls = "mt-1 w-full rounded-lg border border-ink-100/15 bg-ink-800 px-3 py-2.5 text-sm text-ink-100";
const faqs = [
  ["How is the CAT percentile calculated?", "A percentile shows the percentage of candidates who scored below you. Since CAT is conducted in multiple slots, scores are normalised to account for differences in paper difficulty before final percentiles are calculated."],
  ["How accurate is the CAT 2026 percentile predictor?", "The predictor provides an estimate, not an official result. Actual percentiles depend on slot-wise performance, the overall score distribution and IIMs' normalisation process."],
  ["Should I include negative marking for TITA questions?", "No. Incorrect MCQ answers carry a penalty of 1 mark, while incorrect TITA answers carry no negative marking. Enter your final raw score after applying the correct marking scheme."],
  ["When will the CAT 2026 result be declared?", "The CAT 2026 result is expected in January 2027. The exact announcement date will be confirmed by the official CAT authorities. Check iimcat.ac.in for the latest updates."]
];
const u = (p: string) => (p.startsWith("http") ? p : U + p);
// [label, href, optional submenu of [label, href]]
const menu: [string, string, [string, string][]?][] = [
  ["Home", "/"],
  ["About Us", "/about-us/"],
  ["Courses", "/courses/", [["CAT 2027 Coaching", "/cat-2027-coaching"], ["Live Online Academy", "/live-online-academy/"], ["GMAT Preparation", "/gmat-coaching/"], ["GMCAT Prep", "/gmat-cat-coaching/"], ["CAT Preparation", "/cat-coaching/"], ["CUET (UG) 2026 & 2027", "/common-universities-entrance-test/"], ["SAT Preparation", "/sat-preparation/"], ["XAT Preparation", "/xat-preparation/"], ["SNAP Preparation", "/snap-preparation/"], ["NMAT Preparation", "/nmat-preparation/"], ["Mapping Test", "/new-mapping-test/"], ["Profile Evaluator", "/profile-evaluator/"]]],
  ["Free Coaching", "/free-study-suite/", [["Free Daily Practice Tests", "/daily-free-practice-test/"], ["Free CAT Sectional Tests", "/cat-mocks/"], ["Free CAT 2026 Mocks", "/free-cat-mocks/"], ["Student Login", "https://edushastra-free.onrender.com/"]]],
  ["Why Us?", "/why-us/"],
  ["All Results", "/edushastra-results/", [["Profile Evaluator", "/profile-evaluator/"], ["CAT 2025 Response Sheet", "/cat-2025-response-sheet-download-and-free-score-audit/"], ["2025 Results", "/edushastra-caresults/"], ["2024 Results", "/cat-2024-results/"], ["2023 Results", "/cat-2023-results/"], ["2022 Results", "/cat-2022-results/"]]],
  ["Blog", "/blog/"],
  ["Contact Us", "/contact-us/"],
];
type Tbl = { head: string[]; rows: string[][] };
const T: Record<string, Tbl> = {
  five: { head: ["CAT Year", "99 Percentile", "95 Percentile", "90 Percentile"], rows: [["CAT 2025", "84–85", "62–63", "51–52"], ["CAT 2024", "95–96", "70", "57–58"], ["CAT 2023", "76", "54–55", "44–45"], ["CAT 2022", "84", "60–62", "48–49"], ["CAT 2021", "97–98", "72–73", "60"]] },
  y25: { head: ["CAT Percentile", "Approx. Scaled Score"], rows: [["99.99", "132.8"], ["99.95", "118.4"], ["99.90", "111.5"], ["99.50", "93"], ["99", "84.8"], ["98", "76"], ["97", "70"], ["95", "62.3"], ["90", "51.5"], ["85", "44.2"], ["80", "38"], ["75", "33"], ["70", "29.5"], ["60", "23"]] },
  sec: { head: ["Percentile", "VARC", "DILR", "QA"], rows: [["99", "43.2", "29.9", "26.7"], ["98", "39.2", "25.9", "23.4"], ["95", "32.3", "21.2", "18.5"], ["90", "26.4", "16.7", "14.3"], ["85", "22.6", "13.9", "12.1"], ["80", "19.4", "10.0", "10.1"]] },
  good: { head: ["CAT Percentile", "General Performance Level"], rows: [["99+", "Excellent – Highly competitive"], ["95–99", "Very Good – Competitive for several leading B-schools"], ["90–95", "Good – Opens opportunities at many reputed institutes"], ["85–90", "Competitive – Several MBA options available"], ["75–85", "Moderate – Opportunities at selected B-schools"], ["Below 75", "Focus on a wider range of MBA institutions"]] },
};
const tbl = (t: Tbl) => `<div class="glass rounded-2xl overflow-hidden my-5"><div class="overflow-x-auto"><table class="w-full text-sm min-w-[420px]"><thead><tr class="border-b border-ink-100/15">${t.head.map((h) => `<th scope="col" class="text-left px-5 py-3 font-display text-ink-100">${h}</th>`).join("")}</tr></thead><tbody>${t.rows.map((r) => `<tr class="border-b border-ink-100/10 last:border-0 odd:bg-ink-100/[0.03]">${r.map((c, i) => (i ? `<td class="px-5 py-3 text-ink-200">${c}</td>` : `<th scope="row" class="text-left px-5 py-3 font-display text-brand-400">${c}</th>`)).join("")}</tr>`).join("")}</tbody></table></div></div>`;
const ld = [
  { "@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": U },
    { "@type": "ListItem", "position": 2, "name": "CAT Percentile Predictor", "item": PAGE } ] },
  { "@context": "https://schema.org", "@type": "FAQPage", "mainEntity": faqs.map(([q, a]) => ({
    "@type": "Question", "name": q, "acceptedAnswer": { "@type": "Answer", "text": a } })) },
];
---
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{TITLE}</title>
<meta name="description" content={DESC} />
<meta name="robots" content="index, follow" />
<link rel="canonical" href={PAGE} />
<link rel="icon" href="https://www.edushastra.com/wp-content/uploads/2024/09/eduShastra-logo_only-100x100.png" sizes="32x32">
<meta property="og:title" content={TITLE} />
<meta property="og:description" content={DESC} />
<meta property="og:url" content={PAGE} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="EduShastra" />
<meta property="og:locale" content="en_IN" />
<meta name="twitter:card" content="summary" />
<link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:ital,wght@0,300;0,400;0,500;1,300&display=swap" rel="stylesheet" />
{ld.map(x => (<script type="application/ld+json" set:html={JSON.stringify(x)}></script>))}
<script is:inline src="https://cdn.tailwindcss.com"></script>
<script is:inline>
  tailwind.config = { theme: { extend: {
    fontFamily: { display:['Syne','sans-serif'], body:['DM Sans','sans-serif'] },
    colors: {
      brand: { 50:'#fff1e6', 100:'#ffd8b8', 400:'#d9480f', 500:'#d9480f', 600:'#c2410c', 700:'#9a3412' },
      ink: { 900:'#ffead6', 800:'#ffffff', 700:'#ffffff', 400:'#7a5a43', 200:'#6b4d38', 100:'#2b1708' },
    }
  }}}
</script>
<style is:global>
  html { scroll-behavior:smooth; scroll-padding-top:5rem; }
  body { font-family:'DM Sans',sans-serif; background:#fff6ec; color:#2b1708; }
  h1,h2,h3,h4,.font-display { font-family:'Syne',sans-serif; }
  :focus-visible { outline:3px solid #d9480f; outline-offset:3px; border-radius:6px; }
  .hero-bg { background: radial-gradient(ellipse 70% 60% at 15% 50%, rgba(217,72,15,.13) 0%, transparent 60%), #fff6ec; }
  .glass { background:#ffffff; border:1px solid rgba(43,23,8,.12); }
  .glass-gold { background:rgba(217,72,15,.07); border:1px solid rgba(217,72,15,.25); }
  .nav-blur { background:rgba(255,255,255,.92); backdrop-filter:blur(20px); border-bottom:1px solid rgba(43,23,8,.1); }
  .btn { background:#d9480f; color:#ffffff; transition:filter .2s ease; }
  .btn:hover { filter:brightness(1.1); }
  @media (prefers-reduced-motion: reduce) { .btn { transition:none; } html { scroll-behavior:auto; } }
</style>
</head>
<body class="relative overflow-x-hidden">

<nav class="fixed top-0 left-0 right-0 z-50 nav-blur" aria-label="Main">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-2 flex items-center justify-between gap-4">
    <a href={U + "/"} class="shrink-0"><img src="https://www.edushastra.com/wp-content/uploads/2024/09/cropped-eduShastra_new_main.png" alt="EduShastra Education" width="75" height="20" class="h-7 w-auto" /></a>
    <ul class="hidden xl:flex items-center gap-5 text-sm font-bold text-ink-200">
      {menu.map(([label, href, sub]) => (
        <li class="group relative">
          <a href={u(href)} class="inline-block py-3 hover:text-brand-400">{label}{sub && <span aria-hidden="true"> ▾</span>}</a>
          {sub && (
            <ul class="glass absolute left-0 top-full hidden min-w-[16rem] rounded-xl p-2 shadow-lg group-hover:block group-focus-within:block">
              {sub.map(([l, h]) => <li><a href={u(h)} class="block rounded-lg px-3 py-2 hover:bg-brand-50 hover:text-brand-400">{l}</a></li>)}
            </ul>
          )}
        </li>
      ))}
    </ul>
    <div class="flex items-center gap-3">
      <a href={u("/free-study-suite/")} class="btn hidden sm:inline-block text-sm font-semibold px-5 py-2.5 rounded-full">Free Coaching</a>
      <div id="account" class="relative">
        <button id="login-btn" type="button" aria-label="Log in" class="invisible flex items-center gap-2 rounded-full border border-ink-100/20 px-3 py-2 text-sm font-bold text-ink-100 hover:border-brand-400">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-7 8-7s8 3 8 7"/></svg>
          <span class="hidden sm:inline">Log in</span>
        </button>
        <button id="profile-btn" type="button" aria-label="Your profile" aria-haspopup="true" aria-expanded="false" class="hidden h-10 w-10 overflow-hidden rounded-full border border-brand-500 bg-ink-700 text-sm font-bold text-brand-400">
          <img id="avatar" class="hidden h-full w-full object-cover" alt="" referrerpolicy="no-referrer" /><span id="initial"></span>
        </button>
        <div id="menu" class="glass absolute right-0 mt-2 hidden w-64 rounded-xl p-4 text-sm">
          <p id="m-name" class="truncate font-semibold text-ink-100"></p>
          <p id="m-email" class="truncate text-ink-200"></p>
          <button id="logout" type="button" class="mt-3 w-full rounded-lg border border-ink-100/20 py-2 text-ink-100 hover:border-brand-400">Log out</button>
        </div>
      </div>
      <button id="menu-btn" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu" class="xl:hidden flex h-10 w-10 items-center justify-center rounded-full border border-ink-100/20 text-ink-100">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>
  <div id="mobile-menu" class="hidden max-h-[75vh] overflow-y-auto border-t border-ink-100/10 bg-white px-6 py-3 xl:hidden">
    <ul class="text-sm font-bold">
      {menu.map(([label, href]) => <li><a href={u(href)} class="block py-2.5 hover:text-brand-400">{label}</a></li>)}
    </ul>
  </div>
</nav>

<header class="hero-bg pt-28 pb-10 px-6">
  <div class="max-w-7xl mx-auto text-center space-y-5">
    <nav aria-label="Breadcrumb" class="text-xs text-ink-200"><a href="https://www.edushastra.com/" class="hover:text-brand-400">Home</a> / CAT Percentile Predictor</nav>
    <h1 class="font-display text-4xl md:text-6xl font-bold leading-tight text-ink-100">CAT Percentile <span class="text-brand-500">Predictor 2026</span></h1>
    <p class="text-ink-200 text-lg max-w-2xl mx-auto">Enter your marks in each section to estimate your overall and sectional CAT percentile.</p>
    <p id="countdown" class="glass-gold inline-block rounded-full px-5 py-2 text-sm font-semibold text-brand-400">CAT 2026: Sunday, 29 November 2026</p>
  </div>
</header>

<main>
<section id="predictor" class="py-8 px-6">
  <div class="max-w-3xl mx-auto">
    <form id="form" novalidate class="glass rounded-3xl p-6 sm:p-8 space-y-6">
<label class="block text-sm font-bold text-ink-100">Slot
  <select name="slot" required class={inputCls}>
    <option value="">Select your slot</option>
    {openSlots.map((n) => <option value={String(n)}>Slot {n}</option>)}
  </select>
  {openSlots.length < 3 && (
    <span class="mt-1 block text-xs font-normal text-ink-200">
      {openSlots.length === 1
        ? "Slot 2 and Slot 3 will be added once those slots are over."
        : "Slot 3 will be added once it is over."}
    </span>
  )}
</label>
<div class="grid gap-4 sm:grid-cols-3">
  {sections.map((s) => (
    <label class="block rounded-xl border border-ink-100/15 p-4 text-sm font-semibold text-ink-100">
      {s.name} <span class="font-normal text-ink-200">(max {s.max})</span>
      <input type="number" name={s.key} min="-15" max={s.max} step="1" inputmode="numeric" required class={inputCls} />
    </label>
  ))}
</div>
<p class="text-xs text-ink-200">Enter marks after negative marking: +3 per correct answer, -1 per wrong MCQ, and no negative marking for TITA. Negative section scores are allowed.</p>
      <p id="error" role="alert" class="text-sm text-red-700"></p>
      <button type="submit" class="btn w-full rounded-full py-3.5 font-semibold">Predict my percentile</button>
    </form>

    <section id="gate" class="glass-gold mt-6 hidden rounded-3xl p-6 text-center">
      <h2 class="font-display text-2xl font-bold text-ink-100">Log in to see your percentile</h2>
      <p class="mt-2 text-ink-200">It takes one tap with Google. Your answers are saved and your result shows when you return.</p>
      <button id="google" type="button" class="btn mt-4 rounded-full px-7 py-3 font-semibold">Continue with Google</button>
      <p id="gate-error" role="alert" class="mt-3 text-sm text-red-700"></p>
    </section>

    <section id="result" class="glass mt-6 hidden rounded-3xl p-6 text-center" aria-live="polite">
      <p class="text-sm text-ink-200">Your predicted percentile</p>
      <p id="pct" class="font-display text-6xl font-medium text-brand-500"></p>
      <p class="mt-3 text-ink-200">Estimated overall score: <strong id="total" class="text-ink-100"></strong></p>
      <div id="sections" class="mt-5 grid gap-3 sm:grid-cols-3"></div>
      <a href="https://www.edushastra.com/cat-coaching/" class="btn mt-4 inline-block rounded-full px-6 py-3 text-sm font-semibold">Plan your next step with EduShastra</a>
    </section>
  </div>
</section>

<section id="what-is-cat-percentile" class="py-10 px-6"><div class="max-w-7xl mx-auto">
  <h2 class="font-display text-3xl md:text-4xl font-bold text-ink-100 mb-5">What Is CAT Percentile?</h2>
  <div class="space-y-4 leading-relaxed text-ink-200">
    <p>The Common Admission Test (CAT) is a national-level MBA entrance examination conducted for admission to postgraduate management programmes at the Indian Institutes of Management (IIMs) and several other leading B-schools.</p>
    <p>A CAT percentile indicates the percentage of candidates who scored equal to or below your performance in the examination.</p>
    <p>For example:</p>
    <ul class="list-disc pl-6 space-y-1">
      <li><strong class="text-ink-100">99 percentile:</strong> You performed better than approximately 99% of the candidates.</li>
      <li><strong class="text-ink-100">95 percentile:</strong> You performed better than approximately 95% of the candidates.</li>
      <li><strong class="text-ink-100">90 percentile:</strong> You performed better than approximately 90% of the candidates.</li>
      <li><strong class="text-ink-100">80 percentile:</strong> You performed better than approximately 80% of the candidates.</li>
    </ul>
    <p>It is important to understand that a 99 percentile does not mean you scored 99% of the total marks. It represents your relative performance compared with other test takers.</p>
  </div>
</div></section>

<section id="past-years" class="py-10 px-6"><div class="max-w-7xl mx-auto">
  <h2 class="font-display text-3xl md:text-4xl font-bold text-ink-100 mb-5">CAT Score vs Percentile – Previous 5 Years</h2>
  <div class="space-y-4 leading-relaxed text-ink-200">
    <p>The relationship between CAT marks and percentile changes every year depending on the difficulty level of the examination, candidate performance and score normalisation.</p>
    <p>A particular score may result in different percentiles in different CAT examination years.</p>
    <p>The following table provides an approximate comparison of overall scaled scores corresponding to major percentile benchmarks.</p>
    <Fragment set:html={tbl(T.five)} />
    <p class="text-xs italic">Note: These are approximate historical scorecard-based estimates, not official IIM score-to-percentile conversion tables. Scores are presented on the respective year's scoring scale.</p>
    <p>The comparison highlights an important aspect of CAT preparation: the marks required to achieve a particular percentile are not fixed.</p>
    <p>For instance, approximately 76 marks corresponded to the 99 percentile benchmark in CAT 2023, whereas the corresponding benchmark was approximately 95–96 marks in CAT 2024.</p>
    <p>Therefore, candidates should evaluate their performance using year-specific trends rather than relying on a fixed marks-to-percentile formula.</p>
  </div>
</div></section>

<section id="cat-2025-score-vs-percentile" class="py-10 px-6"><div class="max-w-7xl mx-auto">
  <h2 class="font-display text-3xl md:text-4xl font-bold text-ink-100 mb-5">CAT 2025 Score vs Percentile</h2>
  <div class="space-y-4 leading-relaxed text-ink-200">
    <Fragment set:html={tbl(T.y25)} />
  </div>
</div></section>

<section id="sectional-score-vs-percentile" class="py-10 px-6"><div class="max-w-7xl mx-auto">
  <h2 class="font-display text-3xl md:text-4xl font-bold text-ink-100 mb-5">Section-Wise CAT Score vs Percentile</h2>
  <div class="space-y-4 leading-relaxed text-ink-200">
    <p>The CAT examination evaluates candidates across three sections:</p>
    <ol class="list-decimal pl-6 space-y-1">
      <li>Verbal Ability and Reading Comprehension (VARC)</li>
      <li>Data Interpretation and Logical Reasoning (DILR)</li>
      <li>Quantitative Ability (QA)</li>
    </ol>
    <p>Each section receives an independent sectional percentile. Your overall CAT percentile is calculated separately using your total scaled score.</p>
    <p>Sectional Score vs Percentile.</p>
    <Fragment set:html={tbl(T.sec)} />
    <h3 class="font-display text-xl font-bold text-ink-100 pt-2">Why Are Sectional Percentiles Important?</h3>
    <p>Achieving a high overall CAT percentile does not automatically guarantee an IIM interview call.</p>
    <p>Several IIMs specify minimum sectional percentile requirements in VARC, DILR and QA, in addition to an overall percentile requirement.</p>
    <p>Therefore, aspirants should focus on maintaining a balanced performance across all three sections.</p>
  </div>
</div></section>

<section id="how-is-cat-percentile-calculated" class="py-10 px-6"><div class="max-w-7xl mx-auto">
  <h2 class="font-display text-3xl md:text-4xl font-bold text-ink-100 mb-5">How Is CAT Percentile Calculated?</h2>
  <div class="space-y-4 leading-relaxed text-ink-200">
    <p>CAT percentile is calculated by comparing a candidate's performance with that of other candidates who appeared for the examination.</p>
    <p>The official percentile calculation uses the candidate's rank and the total number of candidates who appeared.</p>
    <p>The formula is:</p>
    <p class="glass-gold rounded-2xl px-5 py-4 text-center font-display text-lg font-bold text-ink-100">Percentile = [(N − r) / N] × 100</p>
    <p>Where:</p>
    <ul class="list-disc pl-6 space-y-1">
      <li>N = Total number of candidates who appeared for CAT.</li>
      <li>r = Rank of the candidate based on the relevant scaled score.</li>
    </ul>
    <p>The calculation is performed separately for the overall score and each of the three sections.</p>
    <p>The resulting percentile is rounded to two decimal places.</p>
    <p>This means that your CAT percentile is determined by your relative performance rather than simply the percentage of marks you obtain.</p>
  </div>
</div></section>

<section id="raw-vs-scaled-score" class="py-10 px-6"><div class="max-w-7xl mx-auto">
  <h2 class="font-display text-3xl md:text-4xl font-bold text-ink-100 mb-5">CAT Raw Score vs Scaled Score</h2>
  <div class="space-y-4 leading-relaxed text-ink-200">
    <p>Understanding the difference between raw scores and scaled scores is essential when using a CAT percentile predictor.</p>
    <h3 class="font-display text-xl font-bold text-ink-100">1. Raw Score</h3>
    <p>Your raw score is calculated using the marks awarded for correct and incorrect answers in the examination.</p>
    <p>Under the standard CAT marking scheme:</p>
    <ul class="list-disc pl-6 space-y-1">
      <li>Correct answer: +3 marks</li>
      <li>Incorrect MCQ answer: -1 mark</li>
      <li>Incorrect TITA answer: No negative marking</li>
      <li>Unattempted question: 0 marks</li>
    </ul>
    <h3 class="font-display text-xl font-bold text-ink-100 pt-2">2. Scaled Score</h3>
    <p>CAT is conducted in multiple examination slots. Since the question papers may differ in difficulty, raw scores are normalized to ensure fairness among candidates appearing in different sessions.</p>
    <p>The normalization process adjusts for differences in the score distributions across examination slots.</p>
    <p>The resulting scaled scores are used for calculating the final CAT percentile.</p>
    <p>Therefore, your raw score and final scaled score may not always be identical.</p>
  </div>
</div></section>

<section id="iim-cutoffs" class="py-10 px-6"><div class="max-w-7xl mx-auto">
  <h2 class="font-display text-3xl md:text-4xl font-bold text-ink-100 mb-5">Expected IIM Cutoffs and CAT Percentile Requirements</h2>
  <div class="space-y-4 leading-relaxed text-ink-200">
    <p>The IIMs use CAT scores as an important component of their admission processes. However, the minimum eligibility cutoff and the actual percentile required for shortlisting can be different.</p>
    <p>Admission decisions may also consider:</p>
    <ul class="list-disc pl-6 space-y-1">
      <li>Class 10 academic performance</li>
      <li>Class 12 academic performance</li>
      <li>Graduation marks</li>
      <li>Academic and gender diversity</li>
      <li>Work experience</li>
      <li>CAT overall percentile</li>
      <li>CAT sectional percentiles</li>
      <li>Personal interview performance</li>
      <li>Written ability or other selection components, where applicable</li>
    </ul>
    <p>Candidates should always refer to the latest admission policy published by their target IIM.</p>
    <p>A high CAT percentile can improve your chances of being shortlisted, but it does not guarantee admission.</p>
  </div>
</div></section>

<section id="factors" class="py-10 px-6"><div class="max-w-7xl mx-auto">
  <h2 class="font-display text-3xl md:text-4xl font-bold text-ink-100 mb-5">Factors That Affect Your CAT Percentile</h2>
  <div class="space-y-4 leading-relaxed text-ink-200">
    <p>Several factors influence the relationship between your CAT score and final percentile.</p>
    <div class="grid gap-4 sm:grid-cols-2">
      {[["1. Difficulty Level of the Examination", "If a particular year's CAT examination is more difficult, candidates may achieve higher percentiles at comparatively lower scores."], ["2. Performance of Other Candidates", "Your percentile depends on how your performance compares with the performance of other candidates who appeared for CAT."], ["3. Slot-Wise Normalization", "CAT examinations conducted across multiple slots undergo a normalization process to account for differences in difficulty and score distributions."], ["4. Overall Score", "Your total scaled score determines your overall CAT percentile."], ["5. Sectional Performance", "VARC, DILR and QA are evaluated independently for sectional percentile calculations."]].map(([k, v]) => (
        <div class="glass rounded-2xl p-5"><h3 class="font-display font-bold text-ink-100">{k}</h3><p class="mt-1 text-sm">{v}</p></div>
      ))}
    </div>
  </div>
</div></section>

