---
const U = "https://www.edushastra.com";
const PAGE = `${U}/cat-percentile-predictor/`;
const TITLE = "CAT Percentile Predictor 2026 | Score vs Percentile | EduShastra";
const DESC = "Predict your CAT 2026 percentile from your attempts and correct answers. See CAT 2026 dates, exam pattern and past years score vs percentile data.";
const sections = [
  { key: "varc", name: "VARC", max: 24 },
  { key: "lrdi", name: "LRDI", max: 22 },
  { key: "qa", name: "Quant (QA)", max: 22 },
];
const inputCls = "mt-1 w-full rounded-lg border border-white/10 bg-ink-800 px-3 py-2.5 text-sm text-white";
const info = [
  ["Conducting IIM", "IIM Indore"],
  ["Exam date", "Sunday, 29 November 2026, in three sessions"],
  ["Mode and duration", "Computer-based, 120 minutes, 40 minutes per section"],
  ["Questions", "66 to 68, a mix of MCQ and TITA"],
  ["Marking", "+3 for a correct answer, -1 for a wrong MCQ, no negative marking for TITA"],
  ["Registration", "3 August to 22 September 2026 (extended from 15 September)"],
  ["Admit card", "Available from 4 November 2026"],
  ["Application fee", "Rs 2,700 (general), Rs 1,350 (SC/ST/PwBD)"],
  ["Answer key", "Provisional key expected within a few days of the exam"],
  ["Result", "Expected in the first week of January 2027"],
];
const years = ["2025", "2024", "2023", "2022", "2021", "2020"];
const rows = [
  ["99th", "81-91", "87-92", "77-83", "84", "98", "101"],
  ["95th", "62-70", "65-70", "55-59", "60-62", "73", "76"],
  ["90th", "50-55", "53-58", "48-50", "49", "60", "63"],
];
const faqs = [
  ["How is the CAT percentile calculated?", "A percentile shows the share of candidates who scored below you. Because CAT is held in three slots with different papers, raw scores are scaled across slots before percentiles are worked out."],
  ["How does this predictor work?", "It turns your attempts and correct answers into marks (+3 for correct, -1 for wrong), then compares your marks with estimated score-to-percentile trends from CAT 2025. Slot scaling is not modelled."],
  ["How accurate is it?", "It is an estimate, not a result. Real percentiles depend on the paper's difficulty, the slot scaling and how everyone else performs, so treat the number as a range of a few percentile points either way."],
  ["Why do I need to log in?", "A free Google login shows your result and saves your scores so you can come back to them. We store your email and the scores you enter. Read our Privacy Policy for details."],
  ["Are TITA questions counted correctly?", "TITA questions have no negative marking, but the predictor treats every wrong answer as -1. Your estimate may be slightly lower than your real score."],
  ["When is the CAT 2026 result?", "The result is expected in the first week of January 2027. Check iimcat.ac.in for official dates and updates."],
];
const ld = [
  { "@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": U },
    { "@type": "ListItem", "position": 2, "name": "CAT Percentile Predictor", "item": PAGE } ] },
  { "@context": "https://schema.org", "@type": "FAQPage", "mainEntity": faqs.map(([q, a]) => ({
    "@type": "Question", "name": q, "acceptedAnswer": { "@type": "Answer", "text": a } })) },
];
---
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
