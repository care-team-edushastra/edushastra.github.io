---
// ════════════════════════════════════════════════════════════
//  EduShastra — CAT Online Coaching (Astro)
//  Slug: /cat-online-coaching/
//  Focus keyword: "cat online coaching"
// ════════════════════════════════════════════════════════════
const U = "https://www.edushastra.com";
const PAGE_URL = `${U}/cat-online-coaching/`;
const TITLE = "CAT Online Coaching | Adaptive 5-Level Prep | Edushastra";
const DESCRIPTION = "Best CAT Online coaching by 100%iler faculty. Boost your prep with IQ-based mapping, real-time audio/video interaction, and 24/7 doubt support.";
const OG_IMAGE = `${U}/wp-content/uploads/2026/03/Apex-final-e1774841680687.webp`;

// The CAT 2027 pages this page feeds. Keep these slugs in ONE place.
const P = {
  online: "/cat2027-online-coaching/",       // NOTE: new slug (no hyphen between "cat" and "2027")
  main: "/cat-2027-coaching/",
  delhi: "/cat-2027-coaching-delhi/",
  gurugram: "/cat-2027-coaching-gurugram/",
};

// ── Batch table: every row links to a CAT 2027 page ──
const batches = [
  { name: "Weekday Live Online Batch", mode: "Live online", slot: "Weekdays", href: P.online, cta: "CAT 2027 online batch details" },
  { name: "Weekend Live Online Batch", mode: "Live online", slot: "Weekends", href: P.online, cta: "CAT 2027 online batch details" },
  { name: "Apex-25 Live Online Batch (admission by test)", mode: "Live online", slot: "Weekday / weekend", href: P.online, cta: "See Apex-25 on the CAT 2027 page" },
];

// ── Batch comparison: Elite vs Elite Plus vs Apex-25 (live online). Fees stay on the CAT 2027 page. ──
const APEX_LINK = "/faqs-99ile-apex-30-batch-course-details/";
const formats = [
  { tag: "Larger live batch", title: "Elite Live Online", sub: "Live classes with recordings in a larger cohort. A solid way to get structured, live teaching for the full CAT syllabus.",
    feats: ["500+ hours course cycle", "Live classes and recordings", "150-200 students per batch"],
    href: `${P.online}#batches-elite`, cta: "See Elite Live Online" },
  { tag: "Most popular", title: "Elite Plus Live Online", sub: "A small live batch where you can speak, write and chat in class, so your doubts and progress get far more individual attention.",
    feats: ["Audio, video, writing and chat interaction", "25-30 students per batch", "Weekday and weekend slots"],
    href: P.online, cta: "See Elite Plus Live Online" },
  { tag: "Top percentile", title: "Apex-25 Live Online", sub: "The most personalised batch, capped at 25 students and built for aspirants aiming at the 99+ percentile.",
    feats: ["Highly personalised teaching", "24x7 doubt solving", "Lifetime validity"],
    href: APEX_LINK, cta: "Apply for Apex-25" },
];
const phases = [
  ["Introductory or Mapping Phase","One-on-One Stage","This phase is employed at the beginning and usually takes 2-4 sessions. In this phase, CAT Instructors try to analyze every student in the batch by their interaction with them. This step takes 10% of total course time."],
  ["Foundation Phase","Batch Stage","It covers basics of all sections of CAT. This phase is around 20-50% of the whole course."],
  ["Testing Phase","One-on-One Stage","This phase involves Computer Adaptive Tests, Computer Based Tests, and Paper Based Tests. Every course comes with a commitment of \u201cMinimum Tests\u201d i.e. a minimum number of tests which a student has to attempt to complete the course."],
  ["Control Phase","One-on-One Stage","This last Phase is to look into any gaps in test preparation."],
];

const compare = [
  ["Format", "Live classes + recordings", "Live: audio, video, writing and chat interaction", "Live, highly personalised"],
  ["Batch size", "150-200 students", "25-30 students", "25 students"],
  ["Doubt solving", "Weekly doubt sessions and forum", "In-class interaction plus weekly doubt sessions", "24x7 doubt solving"],
  ["Validity", "Till April 2028", "Till April 2028", "Lifetime"],
  ["Admission", "Open enrolment", "Open enrolment", "By Entrance Mapping Test and academic record review"],
];
const doubtSupport = [
  ["Round-the-clock forum", "Post a question at any hour and experts answer it on a discussion forum."],
  ["Interactive live classes", "Audio, video, writing and chat controls are open to students, so you can ask during the lesson."],
  ["Weekly doubt sessions", "Each subject teacher runs a live doubt session every week."],
  ["Community groups", "Social-media groups let you put queries to experts between classes."],
  ["A panel of teachers", "Every batch has a panel of 7-9 teachers reachable by call or email."],
  ["Student support team", "A dedicated team at support@edushastra.com handles everything else."],
];
const promise = [["6", "+60"], ["7", "+70"], ["8", "+80"], ["9", "+90"], ["10", "+99"]];
const counselling = [
  "Profile evaluation based on IQ and EQ", "Free SNAP, XAT, IIFT and NMAT course", "Soft skills and personal interview preparation",
  "B-school selection based on your profile", "Profile mapping with target schools", "Editing of SOPs, recommendation letters, essays and resumes",
  "Alumni assistance and mentoring", "Rigorous interview preparation", "Education loan and scholarship counselling",
];
const toppers = ["PE9V4W-jlyw", "68NRsAA5o0U", "JtV_nm0zRhQ", "hE7_LGsRO70"];

const faculty = [
  { img: "2023/08/M_L_Parashar.webp", name: "Mr. M L Parashar", cred: "Rtd. Director, Dept. of Science & Tech., Govt. of India", role: "Rtd. Deputy Secretary (Govt. of India) · IIM-A, IIT-K" },
  { img: "2025/09/Vipul-Parashar-EduShastra.webp", name: "Mr. Vipul Parashar", cred: "99.99%ile in CAT 2024, 99.98%ile in CAT 2023, GMAT 780", role: "12+ years mentoring CAT and GMAT aspirants" },
  { img: "2025/02/ayush1.webp", name: "Mr. Ayush Matcha", cred: "99.78%ile in CAT 2022 · IIM Class of 2023-25", role: "4+ years of teaching experience" },
  { img: "2026/01/vibha-e1767786486545.webp", name: "Ms. Vibha Malhotra", cred: "100th percentile in CAT Quant · GMAT Focus 745", role: "16+ years in Quantitative Aptitude coaching" },
  { img: "2024/12/teachers007.webp", name: "Mr. Pawan Shahi", cred: "99.92%ile in CAT 2024 · GMAT Focus 765", role: "NIT graduate and CAT topper turned mentor" },
  { img: "2023/08/Deepak_Jain.webp", name: "Mr. Deepak Jain", cred: "IIT & IIM alumnus · 100th percentile in CAT · GMAT 790", role: "Retired IAS officer, UT administration" },
  { img: "2023/08/kushalbhardwaj.webp", name: "Dr. Kushal Bhardwaj", cred: "Ph.D. (DU) · 99.99%ile CAT · GMAT 780", role: "16+ years in senior IT and retail leadership" },
  { img: "2023/08/ankur-agarwal.webp", name: "Mr. Ankur Agarwal", cred: "16+ years teaching in test prep", role: "Former Deputy Director, LPU" },
];

const cities = [
  ["Delhi NCR", P.delhi], ["Gurugram", P.gurugram], ["Noida", "/cat-2026-noida/"], ["Hyderabad", "/cat-preparation-in-hyderabad/"],
  ["Bengaluru", "/cat2026-preparation-in-bengaluru/"], ["Mumbai", "/cat2026-preparation-in-mumbai/"], ["Chennai", "/cat2026-preparation-in-chennai/"], ["Kolkata", "/cat2026-preparation-in-kolkata/"],
];

// FAQs are written for the broad "CAT online coaching" intent. Fees and plan
// questions are deliberately left to the CAT 2027 online page.
const faqs = [
  ["What is CAT online coaching?", "It is CAT preparation delivered over the internet: live classes on video, recordings, online tests and a doubt-solving channel. At EduShastra the syllabus, the faculty and the four-phase course are the same as in our classroom batches."],
  ["Is online CAT coaching as good as classroom coaching?", "The content is the same, so the difference is mostly about how you learn best. Live online classes keep the fixed timetable and real-time doubts of a classroom, without the commute. If you want a physical centre, the Delhi and Gurugram pages cover that."],
  ["How is live online different from watching free videos?", "A free video cannot see where you are stuck. In a live class the teacher answers your question in the same session, and your batch is matched to your level through the Entrance Mapping Test."],
  ["Do I need to prepare for the Mapping Test?", "No. It is an IQ-based test, not a knowledge test. It only decides which of the five percentile groups you start in, and you can move up as your scores improve."],
  ["Can I start with a free class?", "Yes. The free live hybrid course lets you attend live classes with recordings and in-class doubt solving, so you can judge the teaching before you pay for anything."],
  ["Will I get mock tests in an online course?", "Yes. The testing phase includes sectional tests, full-length mocks and computer-adaptive tests, each with performance analysis."],
  ["What do I need to attend classes?", "A laptop or smartphone and a steady internet connection. Classes run on a standard video platform with audio, video and chat."],
  ["What happens in the first week of an online batch?", "You begin with a diagnostic week. Instructors look at your strengths in logic and quant, and the Entrance Mapping Test places you in one of five percentile-based batch series."],
  ["How do I get doubts solved between live classes?", "Use the 24x7 discussion forum, the weekly live doubt session for each subject, the community groups, or write to your batch's panel of teachers. The student support team covers anything else."],
  ["Is online coaching covered by the money-back promise?", "EduShastra backs its courses with a money-back promise, and each batch series has its own percentile target, from +60 for the 6-Series to +99 for the 10-Series. Read the full terms on the Money-Back Promise page before you enrol."],
  ["Do you help with B-school admissions after CAT?", "Yes. Admission counselling is part of the courses and includes profile evaluation, interview preparation, SOP and resume editing, and loan and scholarship guidance."],
  ["Where can I see fees and the full plan comparison?", "Prices and the side-by-side comparison of Elite, Elite Plus and Apex-25 are kept up to date on the CAT 2027 online coaching page, so you always see the current numbers in one place."],
];

const faqLd = { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faqs.map(([q, a]) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })) };
const crumbLd = { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [
  { "@type": "ListItem", position: 1, name: "Home", item: U },
  { "@type": "ListItem", position: 2, name: "CAT Coaching", item: `${U}/cat-prep/` },
  { "@type": "ListItem", position: 3, name: "CAT Online Coaching", item: PAGE_URL }] };
const pageLd = { "@context": "https://schema.org", "@type": "WebPage", name: TITLE, url: PAGE_URL, description: DESCRIPTION,
  isPartOf: { "@type": "WebSite", name: "EduShastra", url: `${U}/` },
  about: { "@type": "Thing", name: "CAT online coaching" } };
---
<!DOCTYPE html>
<html lang="en-IN" class="scroll-smooth">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{TITLE}</title>
<meta name="description" content={DESCRIPTION} />
<meta name="robots" content="index, follow, max-image-preview:large" />
<link rel="canonical" href={PAGE_URL} />
<link rel="icon" href="https://www.edushastra.com/wp-content/uploads/2024/09/eduShastra-logo_only-100x100.png" sizes="32x32">
<meta property="og:title" content={TITLE} />
<meta property="og:description" content={DESCRIPTION} />
<meta property="og:url" content={PAGE_URL} />
<meta property="og:type" content="website" />
<meta property="og:image" content={OG_IMAGE} />
<meta name="twitter:card" content="summary_large_image" />
<link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:ital,wght@0,300;0,400;0,500;1,300&display=swap" rel="stylesheet" />
<script type="application/ld+json" set:html={JSON.stringify(pageLd)}></script>
<script type="application/ld+json" set:html={JSON.stringify(faqLd)}></script>
<script type="application/ld+json" set:html={JSON.stringify(crumbLd)}></script>
<script is:inline src="https://cdn.tailwindcss.com"></script>
<script is:inline>
  tailwind.config = { theme: { extend: {
    fontFamily: { display:['Syne','sans-serif'], body:['DM Sans','sans-serif'] },
    colors: {
      brand: { 50:'#f7ecd5', 100:'#f0dcae', 400:'#e3ab2b', 500:'#e3ab2b', 600:'#e3ab2b', 700:'#e3ab2b' },
      ink: { 900:'#0c1016', 800:'#12161f', 700:'#151a24', 400:'#6b7284', 200:'#a6adbb', 100:'#eef0f4' },
    }
  }}}
</script>
<style>
  body { font-family:'DM Sans',sans-serif; background:#0c1016; color:#eef0f4; }
  h1,h2,h3,h4,h5,.font-display { font-family:'Syne',sans-serif; }
  :focus-visible { outline:3px solid #e3ab2b; outline-offset:3px; border-radius:6px; }
  .hero-bg { background: radial-gradient(ellipse 70% 60% at 15% 50%, rgba(227,171,43,.15) 0%, transparent 60%), radial-gradient(ellipse 50% 70% at 85% 20%, rgba(227,171,43,.08) 0%, transparent 55%), #0c1016; }
  .glass { background:#151a24; border:1px solid rgba(255,255,255,.09); }
  .glass-gold { background:rgba(227,171,43,.06); border:1px solid rgba(227,171,43,.2); }
  .nav-blur { background:rgba(12,16,22,.85); backdrop-filter:blur(20px); border-bottom:1px solid rgba(255,255,255,.06); }
  .btn { background:#e3ab2b; color:#0c1016; transition:filter .2s ease, box-shadow .2s ease; }
  .btn:hover { filter:brightness(1.1); }
  .cta-glow:hover { box-shadow:0 0 32px rgba(227,171,43,.5); }
  .reveal { opacity:0; transform:translateY(28px); transition:opacity .7s ease, transform .7s ease; }
  .revealed { opacity:1; transform:translateY(0); }
  .tag { font-size:10px; font-weight:700; letter-spacing:.08em; text-transform:uppercase; padding:3px 10px; border-radius:999px; display:inline-block; }
  .chip-on { background:rgba(227,171,43,.12); color:#e3ab2b; border:1px solid rgba(227,171,43,.25); }
  .badge-online { background:rgba(73,199,184,.15); color:#49c7b8; border:1px solid rgba(73,199,184,.3); }
  .badge-hybrid { background:rgba(150,130,255,.15); color:#a898ff; border:1px solid rgba(150,130,255,.3); }
  .lift { transition:transform .3s ease, border-color .3s ease; } .lift:hover { transform:translateY(-4px); border-color:rgba(227,171,43,.5); }
  .table-row:nth-child(even) { background:rgba(255,255,255,.02); }
  .table-row:hover { background:rgba(227,171,43,.06); }
  @media (prefers-reduced-motion: reduce) { .reveal { opacity:1; transform:none; transition:none; } }
</style>
</head>
