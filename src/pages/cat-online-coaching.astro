<main>
<!-- INTRO -->
<section class="py-5 px-6">
  <div class="max-w-7xl mx-auto">
    <div class="reveal mb-4 text-center">
      <h2 class="font-display text-4xl md:text-5xl font-800 text-white">CAT Online <span class="text-brand-500">Coaching</span></h2>
    </div>
    <div class="reveal space-y-5 text-ink-200 text-base leading-relaxed">
      <p>Cracking the CAT isn’t about studying endless hours—it’s about studying smart. Instead of boring, pre-recorded videos, our online coaching gives you high-energy live classes where you can interact and learn in real time.</p>
      <p>We don't just teach the syllabus; we teach you the art of test-taking. With personalized mentorship, adaptive study plans, and 24/7 doubt resolution, we help you turn your weak areas into scoring strengths. Whether you are a college student or a working professional, our flexible ecosystem ensures you stay ahead of the curve.</p>
    </div>
  </div>
</section>

<!-- BATCHES → CAT 2027 PAGES -->
<section id="batches" class="py-5 px-6 bg-ink-800/20">
  <div class="max-w-7xl mx-auto">
    <div class="reveal mb-5 text-center">
      <p class="text-brand-400 text-xs font-semibold tracking-widest uppercase mb-3">Upcoming Batches</p>
      <h2 class="font-display text-4xl md:text-5xl font-800 text-white">Online &amp; Hybrid Batches</h2>
      <p class="text-ink-200 max-w-2xl mx-auto mt-4">Each batch below opens its CAT 2027 page, where you will find the current fees, schedule and enrolment steps.</p>
    </div>
    <div class="reveal glass rounded-3xl overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <caption class="sr-only">Online and hybrid CAT batches with start dates and links to the CAT 2027 pages</caption>
          <thead>
            <tr class="border-b border-white/10 bg-white/5">
              {["Batch", "Mode", "Slot", "Batch Start", "Details"].map(h => <th scope="col" class="text-left px-6 py-4 font-semibold text-ink-200 font-display">{h}</th>)}
            </tr>
          </thead>
          <tbody>
            {batches.map(b => (
              <tr class="table-row border-b border-white/5">
                <td class="px-6 py-4 text-white font-medium">{b.name}</td>
                <td class="px-6 py-4"><span class={`tag ${b.mode === "Hybrid" ? "badge-hybrid" : "badge-online"}`}>{b.mode}</span></td>
                <td class="px-6 py-4 text-ink-200">{b.slot}</td>
                <td class="px-6 py-4 text-ink-200">27 October</td>
                <td class="px-6 py-4"><a href={`${U}${b.href}`} class="text-brand-400 hover:text-brand-100 font-semibold">{b.cta} →</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>

<!-- FORMATS -->
<section id="formats" class="py-5 px-6">
  <div class="max-w-7xl mx-auto">
    <div class="reveal mb-5 text-center">
      <h2 class="font-display text-4xl md:text-5xl font-800 text-white"> <span class="text-brand-500">CAT Live Online Courses</span></h2>
    </div>
    <div class="grid md:grid-cols-3 gap-6">
      {formats.map(c => (
        <div class="reveal lift glass rounded-3xl overflow-hidden flex flex-col">
          <div class="h-1 bg-gradient-to-r from-brand-500 to-brand-400"></div>
          <div class="p-5 flex flex-col flex-1">
            <span class="tag chip-on mb-3 self-start">{c.tag}</span>
