<!-- HERO -->
<header class="hero-bg relative min-h-screen flex items-center pt-24 pb-8 px-6">
  <div class="max-w-7xl mx-auto w-full grid lg:grid-cols-2 gap-14 items-center relative z-10">
    <div class="space-y-6">
      <nav aria-label="Breadcrumb" class="text-xs text-ink-200"><a href="https://www.edushastra.com/" class="hover:text-brand-400">Home</a> <span class="mx-1">/</span> CAT Online Coaching</nav>
      <div class="inline-flex items-center gap-2 bg-brand-500/10 border border-brand-500/30 rounded-full px-4 py-1.5 text-brand-400 text-xs font-semibold tracking-widest uppercase">
