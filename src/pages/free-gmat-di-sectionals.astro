              <p class="text-ink-400 mt-0.5">Duration</p>
            </div>
          </div>
          <a href={TEST_LINKS[0]} class="block text-center bg-cyan-600 hover:bg-cyan-700 text-white text-sm font-semibold px-4 py-2.5 rounded-full transition-all cta-glow">
