<!-- ══════════════════════════════
     DI TIPS
══════════════════════════════ -->
<section class="py-16 px-6 bg-ink-800/20">
  <div class="max-w-7xl mx-auto">
    <div class="reveal mb-10 text-center">
      <h2 class="font-display text-4xl md:text-5xl font-800 text-white">
        The Data Insights <span class="text-cyan-400">Strategy That Works</span>
      </h2>
    </div>
    <div class="grid md:grid-cols-3 gap-5">
      {[
        { icon: "🔍", title: "Read the Source Before the Question", desc: "Multi-Source Reasoning and Table Analysis punish rushing straight to the answer choices. Spend the first 30 seconds mapping what each tab or column actually represents — our tests train this habit under time pressure." },
        { icon: "📐", title: "Data Sufficiency Is Logic, Not Math", desc: "Most DS errors come from solving instead of testing sufficiency. Focus on whether each statement pins down a unique answer, not the arithmetic itself. This shift is what separates a 70th from a 90th percentile DI score." },
        { icon: "🧮", title: "The Onscreen Calculator Is a Trap", desc: "DI allows a basic calculator, but leaning on it slows you down on questions built for estimation and pattern spotting. Our tests are timed to reward the questions where mental math beats the calculator." },
      ].map(f => (
        <div class="reveal glass rounded-2xl p-6">
          <h4 class="font-display font-700 text-cyan-400 text-xl mb-3">{f.icon} {f.title}</h4>
          <p class="text-white text-sm leading-relaxed">{f.desc}</p>
        </div>
      ))}
    </div>

    <div class="reveal glass-teal rounded-3xl p-8 mt-10 flex flex-col md:flex-row items-center justify-between gap-6">
      <div>
        <p class="font-display font-700 text-white text-xl mb-1">Want structured Data Insights training?</p>
        <p class="text-ink-200 text-sm">Our GMAT DI modules include 50+ sets with live faculty walkthroughs and strategy sessions across all five question types.</p>
      </div>
      <a href="https://www.edushastra.com/gmat-prep/#batches" class="cta-orange bg-brand-500 hover:bg-brand-600 text-white text-sm font-semibold px-6 py-3 rounded-full transition-all whitespace-nowrap">
        Explore Batches →
      </a>
    </div>
  </div>
</section>

<!-- ══════════════════════════════
     FAQs
══════════════════════════════ -->
<section id="faqs" class="py-16 px-6">
  <div class="max-w-4xl mx-auto">
    <div class="reveal mb-12 text-center">
      <p class="text-cyan-400 text-xs font-semibold tracking-widest uppercase mb-3">Common Questions</p>
      <h2 class="font-display text-4xl font-800 text-white">Data Insights Test FAQs</h2>
    </div>
    <div class="space-y-3">
      {[
        { q: "Are these GMAT Data Insights tests free?", a: "Yes — all 4 DI tests are completely free with no signup fee. Click any 'Access Now' button to begin immediately." },
        { q: "How many questions are in each DI test?", a: "Each test has 20 questions spanning all five Data Insights question types, matching the actual GMAT Focus Edition section structure." },
        { q: "What question types are covered?", a: "Across the 4 tests we cover Data Sufficiency, Table Analysis, Graphics Interpretation, Multi-Source Reasoning and Two-Part Analysis, using bar charts, scatter plots, sortable tables and multi-tab sources." },
        { q: "Is DI scoring different from other sections?", a: "Data Insights contributes to your overall GMAT Focus score using the same adaptive scoring model as Quant and Verbal. Our tests replicate the question format and difficulty calibration." },
        { q: "Can I use a calculator during the test?", a: "Yes — like the real GMAT Focus Edition, an onscreen calculator is available for the Data Insights section only, and our tests include the same tool." },
        { q: "Will I get explanations for each question?", a: "Yes — complete solutions with approach explanation and optimal solving strategy are provided immediately after submission." },
      ].map((faq, i) => (
        <div class="reveal glass rounded-2xl overflow-hidden">
          <button class="faq-btn w-full text-left px-7 py-5 flex items-start justify-between gap-4" data-index={i}>
            <span class="font-display font-700 text-white text-sm leading-relaxed">{faq.q}</span>
            <span class="faq-icon text-cyan-400 flex-shrink-0 mt-0.5 text-lg">+</span>
          </button>
          <div class="faq-body hidden px-7 pb-6">
            <p class="text-ink-200 text-sm leading-relaxed">{faq.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ══════════════════════════════
     FOOTER
