<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Is this really live, or just pre-recorded videos I watch on my own?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Fully live. A faculty member teaches in real time on every scheduled session, takes questions as they come up, and adjusts pace to the batch. Sessions are recorded afterward only for your revision — nothing is pre-shot."
      }
    },
    {
      "@type": "Question",
      "name": "How does doubt-solving work if I'm not in a physical classroom?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "You can ask during the live session itself via audio, video, or chat, or raise it in our 24x7 doubt-solving channel outside class hours. Either way, a teacher — not a bot — responds."
      }
    },
    {
      "@type": "Question",
      "name": "How are online batches placed into IQ-based Series?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The same Entrance Mapping Test used for offline batches applies online. It's IQ-based, not knowledge-based, and places you into one of five Series so your online batchmates are at a similar ability level."
      }
    },
    {
      "@type": "Question",
      "name": "What happens if I miss a live class?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Every live session is recorded and added to your portal the same day, so you can catch up before the next weekly evaluation test without falling behind the batch's pace."
      }
    },
    {
      "@type": "Question",
      "name": "Do online students get the same weekly evaluation tests as offline batches?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Sectional and full-length Computer-Adaptive, Computer-Based, or Paper-Based tests run weekly for every batch, live or offline, and feed directly into course-path adjustments."
      }
    },
    {
      "@type": "Question",
      "name": "What internet speed or setup do I need for live sessions?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A stable broadband or 4G connection (minimum ~2 Mbps) and any laptop, tablet, or phone with a browser. No special software installation is required to join a session."
      }
    },
    {
      "@type": "Question",
      "name": "Can I switch from the online batch to a classroom or hybrid batch later?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, subject to seat availability in the target batch. Since course structure and Series placement carry over, switching modes doesn't reset your progress."
      }
    }
  ]
}
</script>

