  ["How does doubt-solving work if I'm not in a physical classroom?","You can ask during the live session itself via audio, video, or chat, or raise it in our 24×7 doubt-solving channel outside class hours. Either way, a teacher, not a bot, responds."],
  ["How are online batches placed into IQ-based Series?","The same Entrance Mapping Test used for offline batches applies online. It's IQ-based, not knowledge-based, and places you into one of five Series so your online batchmates are at a similar ability level."],
  ["What happens if I miss a live class?","Every live session is recorded and added to your portal the same day, so you can catch up before the next weekly evaluation test without falling behind the batch's pace."],
  ["Do online students get the same weekly evaluation tests as offline batches?","Yes. Sectional and full-length Computer-Adaptive, Computer-Based, or Paper-Based tests run weekly for every batch, live or offline, and feed directly into course-path adjustments."],
  ["What internet speed or setup do I need for live sessions?","A stable broadband or 4G connection (minimum ~2 Mbps) and any laptop, tablet, or phone with a browser. No special software installation is required to join a session."],
  ["Can I switch from the online batch to a classroom or hybrid batch later?","Yes, subject to seat availability in the target batch. Since course structure and Series placement carry over, switching modes doesn't reset your progress."],
];
// JSON-LD is generated from the same data as the page, so prices can never drift out of sync.
const price = (p) => Number(String(p).replace(/[^\d]/g, "")) || 0;
const mode = { Online:"online", Classroom:"onsite", Hybrid:"blended" };
const inst = (name, p, m, url, hours) => ({ "@type":"CourseInstance", name, courseMode: mode[m], ...(hours ? { courseWorkload: hours } : {}),
  offers: { "@type":"Offer", name, price: price(p), priceCurrency:"INR", url: `${U}${url}`, availability:"https://schema.org/InStock" } });
const instances = [
  ...elite.map(([m,name,p,,,enroll]) => inst(name,p,m,enroll, name.includes("Test Series") ? null : "PT250H")),
  ...elitePlus.map(([m,name,p]) => inst(name,p,m,"/gmat-courses-payment-portal/","PT250H")),
  ...apex.map(([m,label,p]) => inst(`Apex-25 ${label}`,p,m,"/gmat-courses-payment-portal/","PT500H")),
];
const courseLd = { "@context":"https://schema.org","@type":"Course","@id":`${PAGE}#course`,"name":"GMAT Online Coaching","url":PAGE,
  "description":"Live online GMAT Focus coaching with 100%ile faculty, IQ-based percentile batching across five Series, weekly adaptive evaluation tests and a +720 or fee refund promise.",
  "provider":{"@type":"Organization","name":"EduShastra","url":U}, "hasCourseInstance": instances };
const faqLd = { "@context":"https://schema.org","@type":"FAQPage","mainEntity": faqs.map(([q,a]) => ({"@type":"Question","name":q,"acceptedAnswer":{"@type":"Answer","text":a}})) };
const crumbLd = { "@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[
  {"@type":"ListItem","position":1,"name":"Home","item":U},
  {"@type":"ListItem","position":2,"name":"GMAT Coaching","item":`${U}/gmat-focus-prep/`},
  {"@type":"ListItem","position":3,"name":"GMAT Online Coaching","item":PAGE}] };
