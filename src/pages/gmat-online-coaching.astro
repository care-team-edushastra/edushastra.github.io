  <style>
    body { font-family: 'DM Sans', sans-serif; background: #051615; color: #f1faf9; }
    h1,h2,h3,h4,h5,.font-display { font-family: 'Syne', sans-serif; }

    body::before {
      content: '';
      position: fixed; inset: 0; z-index: 0; pointer-events: none;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
      opacity: 0.35;
    }

    .hero-bg {
      background:
        radial-gradient(ellipse 70% 60% at 15% 50%, rgba(20,184,166,0.15) 0%, transparent 60%),
        radial-gradient(ellipse 50% 70% at 85% 20%, rgba(20,184,166,0.08) 0%, transparent 55%),
        #051615;
    }

    .glass {
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.09);
      backdrop-filter: blur(12px);
    }

    .glass-orange {
      background: rgba(20,184,166,0.06);
      border: 1px solid rgba(20,184,166,0.2);
      backdrop-filter: blur(12px);
    }

    .nav-blur {
      background: rgba(5,22,21,0.8);
      backdrop-filter: blur(20px);
      border-bottom: 1px solid rgba(255,255,255,0.06);
    }

    .cta-glow:hover { box-shadow: 0 0 32px rgba(20,184,166,0.5); }

    .reveal { opacity: 0; transform: translateY(28px); transition: opacity 0.7s ease, transform 0.7s ease; }
    .revealed { opacity: 1; transform: translateY(0); }

    .batch-tag {
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      padding: 3px 10px;
      border-radius: 999px;
    }

    .tier-card { transition: transform 0.3s ease, border-color 0.3s ease; }
    .tier-card:hover { transform: translateY(-4px); }

    .badge-online  { background: rgba(59,130,246,0.15); color: #93c5fd; border: 1px solid rgba(59,130,246,0.3); }
    .badge-offline { background: rgba(34,197,94,0.12); color: #86efac; border: 1px solid rgba(34,197,94,0.25); }
    .badge-hybrid  { background: rgba(168,85,247,0.12); color: #d8b4fe; border: 1px solid rgba(168,85,247,0.25); }

    .table-row:nth-child(even) { background: rgba(255,255,255,0.02); }
    .table-row:hover { background: rgba(20,184,166,0.06); }

    .slider-track { display: flex; gap: 1.5rem; transition: transform 0.5s cubic-bezier(0.4,0,0.2,1); }
        .media-scroller {
      overflow: hidden;
      /* Fade out the left and right edges for a polished infinite feel */
      mask-image: linear-gradient(
        to right,
        transparent 0%,
        black 8%,
        black 92%,
        transparent 100%
      );
      -webkit-mask-image: linear-gradient(
        to right,
        transparent 0%,
        black 8%,
        black 92%,
        transparent 100%
      );
    }

    .media-track {
      display: flex;
      gap: 1.5rem;
      /* Each card is ~280px wide + 1.5rem gap; the track holds 8 cards (4 real + 4 clones)
         so translateX(-50%) always lands back at the start seamlessly */
      width: max-content;
      animation: marquee 40s linear infinite;
    }
@keyframes marquee {
  0%   { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}
    /* Pause on hover so users can read the card */
    .media-track:hover {
      animation-play-state: paused;
    }

    .media-card {
      flex: 0 0 280px;         /* fixed width per card */
      transition: border-color 0.3s ease, transform 0.3s ease;
    }

    .media-card:hover {
      transform: translateY(-4px);
    }
  </style>
</head>

