---
// CAT Percentile Predictor: /cat-percentile-predictor
// Max questions per section. Change these if the CAT pattern changes.
const sections = [
  { key: 'varc', name: 'VARC', max: 24 },
  { key: 'lrdi', name: 'LRDI', max: 22 },
  { key: 'qa', name: 'Quant (QA)', max: 22 },
]
const input = 'mt-1 w-full rounded-lg border border-slate-300 bg-slate-50 px-3 py-2 text-sm'
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>CAT Percentile Predictor 2026 | EduShastra</title>
  <meta name="description" content="Enter your expected CAT attempts and correct answers to predict your percentile." />
  <script is:inline src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-50 text-slate-900">
<main class="mx-auto max-w-3xl p-4 sm:p-8">
  <h1 class="text-3xl font-bold sm:text-4xl">CAT Percentile Predictor</h1>
  <p class="mt-2 text-slate-600">Enter your slot and, for each section, how many questions you attempted and expect to be correct.</p>
  <p id="sample-note" class="mt-4 hidden rounded-lg bg-amber-100 p-3 text-sm text-amber-900">
    Sample data in use. Replace the table in <code>src/data/catPercentile.js</code> before publishing.
  </p>

  <form id="form" novalidate class="mt-6 space-y-6 rounded-2xl bg-white p-6 shadow">
    <label class="block text-sm font-medium">Slot
      <select name="slot" required class={input}>
        <option value="">Select your slot</option>
        <option value="1">Slot 1</option><option value="2">Slot 2</option><option value="3">Slot 3</option>
      </select>
    </label>
    <div class="grid gap-4 sm:grid-cols-3">
      {sections.map((s) => (
        <fieldset class="rounded-lg border border-slate-200 p-4">
          <legend class="px-1 text-sm font-semibold">{s.name} <span class="font-normal text-slate-500">(max {s.max})</span></legend>
          <label class="block text-xs font-medium text-slate-600">Attempted
            <input type="number" name={s.key + '_attempted'} min="0" max={s.max} required class={input} />
          </label>
          <label class="mt-3 block text-xs font-medium text-slate-600">Expected correct
            <input type="number" name={s.key + '_correct'} min="0" max={s.max} required class={input} />
          </label>
        </fieldset>
      ))}
    </div>
    <p id="error" role="alert" class="text-sm text-red-600"></p>
    <button type="submit" class="w-full rounded-lg bg-blue-600 py-3 font-semibold text-white hover:bg-blue-700">Submit</button>
  </form>

  <section id="gate" class="mt-6 hidden rounded-2xl bg-white p-6 text-center shadow">
    <h2 class="text-xl font-bold">Log in to see your percentile</h2>
    <p class="mt-2 text-slate-600">It takes one tap. Your answers are saved and your result shows when you return.</p>
    <button id="google" class="mt-4 rounded-lg border border-slate-300 px-6 py-3 font-medium hover:bg-slate-100">Continue with Google</button>
    <p id="gate-error" role="alert" class="mt-3 text-sm text-red-600"></p>
  </section>

  <section id="result" class="mt-6 hidden rounded-2xl bg-white p-6 text-center shadow" aria-live="polite">
    <p class="text-sm text-slate-500">Your predicted percentile</p>
    <p id="pct" class="text-6xl font-bold text-blue-600"></p>
    <p class="mt-3 text-slate-700">Estimated overall score: <strong id="total"></strong></p>
    <p id="parts" class="mt-1 text-sm text-slate-500"></p>
    <p class="mt-4 text-xs text-slate-500">This is an estimate. Real percentiles depend on the actual exam and normalisation.</p>
  </section>
</main>

<script>
  import { supabase } from '../lib/supabase'
  import { estimate, isSample } from '../data/catPercentile.js'

  const $ = (id) => document.getElementById(id)
  const form = $('form')
  const KEY = 'catPredictorForm'
  const PENDING = 'catPredictorPending'
  const KEYS = ['varc', 'lrdi', 'qa']

  if (isSample) $('sample-note').classList.remove('hidden')

  const readForm = () => {
    const d = {}
    new FormData(form).forEach((v, k) => { d[k] = String(v) })
    return d
  }
  const fillForm = (d) => {
    Object.entries(d).forEach(([k, v]) => { if (form.elements[k]) form.elements[k].value = v })
  }

  function validate(d) {
    if (!d.slot) return 'Please select your slot.'
    for (const k of KEYS) {
      const max = Number(form.elements[k + '_attempted'].max)
      const a = d[k + '_attempted'], c = d[k + '_correct']
      if (a === '' || c === '') return 'Please fill in every field.'
      if (Number(a) < 0 || Number(c) < 0 || Number(a) > max) return 'Attempted questions must be between 0 and ' + max + '.'
      if (Number(c) > Number(a)) return 'Correct answers cannot be more than attempted.'
    }
    return ''
  }

  // +3 per correct answer, -1 per wrong answer (assumes every wrong answer is negatively marked).
  function score(d) {
    let total = 0
    const parts = []
    for (const k of KEYS) {
      const a = Number(d[k + '_attempted']), c = Number(d[k + '_correct'])
      const s = 3 * c - (a - c)
      total += s
      parts.push(k.toUpperCase() + ' ' + s)
    }
    return { total, parts: parts.join('  |  ') }
  }

  async function run(d) {
    const { data } = await supabase.auth.getSession()
    if (data.session) {
      const { total, parts } = score(d)
      $('pct').textContent = estimate(d.slot, total).toFixed(2)
      $('total').textContent = total
      $('parts').textContent = parts
      $('gate').classList.add('hidden')
      $('result').classList.remove('hidden')
      $('result').scrollIntoView({ behavior: 'smooth' })
    } else {
      $('result').classList.add('hidden')
      $('gate').classList.remove('hidden')
      $('gate').scrollIntoView({ behavior: 'smooth' })
    }
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault()
    const d = readForm()
    const err = validate(d)
    $('error').textContent = err
    if (err) return
    try { localStorage.setItem(KEY, JSON.stringify(d)) } catch (x) {}
    run(d)
  })

  $('google').addEventListener('click', async () => {
    try { localStorage.setItem(PENDING, '1') } catch (x) {}
    const { error } = await supabase.auth.signInWithOAuth({
      provider: 'google',
      options: { redirectTo: window.location.origin + window.location.pathname },
    })
    if (error) $('gate-error').textContent = 'Could not start login. Please try again.'
  })

  // After the Google redirect, restore the saved answers and show the result.
  async function restore() {
    let saved = null
    try { saved = JSON.parse(localStorage.getItem(KEY) || 'null') } catch (x) {}
    if (!saved) return
    fillForm(saved)
    let pending = false
    try { pending = localStorage.getItem(PENDING) === '1' } catch (x) {}
    if (!pending) return
    const { data } = await supabase.auth.getSession()
    if (data.session) {
      try { localStorage.removeItem(PENDING) } catch (x) {}
      if (!validate(saved)) run(saved)
    }
  }
  restore()
</script>
</body>
</html>
