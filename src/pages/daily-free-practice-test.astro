---
// EduShastra — Daily Practice Page (Astro)
// Matches CAT 2026 / CUET design: dark bg, orange accent, glassmorphism, Syne + DM Sans
const TEST_LINK = "https://edushastra-free.onrender.com/"; // placeholder — same link for every CAT test
const GMAT_TEST_LINK = "https://edushastra-free.onrender.com/"; // GMAT LINK: replace with real GMAT daily test URL — same link for every GMAT test

// 6 static card slots — actual dates are filled in client-side (see script at
// the bottom) so the page always shows "today" back through "today - 5",
// without needing a rebuild. data-day-offset tells the script which date
// belongs in which card. Used for BOTH the CAT and GMAT grids.
const dailyCardSlots = [0, 1, 2, 3, 4, 5];
---
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Free CAT 2026 & GMAT  Daily Mock & Free Practice Tests | EduShastra</title>
<link rel="icon" href="https://www.edushastra.com/wp-content/uploads/2024/09/eduShastra-logo_only-100x100.png" sizes="32x32"><link rel="icon" href="https://www.edushastra.com/wp-content/uploads/2024/09/eduShastra-logo_only-300x300.png" sizes="192x192">
  <meta name="description" content="Boost your prep with a Free CAT 2026 & GMAT Daily Mock. Practice a new 40-minute free CAT/GMAT daily test every day. Track your scores and build consistency for CAT & GMAT!" />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href="https://www.edushastra.com/daily-practice/" />

  <meta property="og:title" content="Free CAT 2026 & GMAT Daily Mock & Free Practice Tests | EduShastra" />
  <meta property="og:description" content="Boost your prep with a Free CAT 2026 & GMAT Daily Mock. Practice a new 40-minute free CAT/GMAT daily test every day. Track your scores and build consistency for CAT & GMAT!" />
  <meta property="og:url" content="https://www.edushastra.com/daily-practice/" />
  <meta property="og:type" content="website" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:ital,wght@0,300;0,400;0,500;1,300&display=swap" rel="stylesheet" />

   <script is:inline src="https://cdn.tailwindcss.com"></script>
  <script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            display: ['Syne', 'sans-serif'],
            body: ['DM Sans', 'sans-serif'],
          },
          colors: {
            brand: {
              50:  '#fff7ed',
              100: '#ffedd5',
              400: '#fb923c',
              500: '#f97316',
              600: '#ea6c0a',
              700: '#c2540a',
            },
            ink: {
              900: '#0d0d0d',
              800: '#1a1a1a',
              700: '#2d2d2d',
              400: '#6b6b6b',
              200: '#d4d4d4',
              100: '#f5f5f5',
            }
          },
        }
      }
    }
  </script>

  <style>
    /* ── Page-wide accent theme ──
       Everything that should switch between CAT (orange) and GMAT (teal)
       reads from these variables instead of the fixed Tailwind "brand-*"
       colors. Toggled by setting data-theme="cat" | "gmat" on <body>. */
    :root {
      --accent-rgb: 249,115,22;
      --accent-100: #ffedd5;
      --accent-400: #fb923c;
      --accent-500: #f97316;
      --accent-600: #ea6c0a;
      --accent-700: #c2540a;
    }
    body[data-theme="gmat"] {
      --accent-rgb: 20,184,166;
      --accent-100: #ccfbf1;
      --accent-400: #5eead4;
      --accent-500: #14b8a6;
      --accent-600: #0d9488;
      --accent-700: #0f766e;
    }

    body { font-family: 'DM Sans', sans-serif; background: #0d0d0d; color: #f5f5f5; }
    h1,h2,h3,h4,h5,.font-display { font-family: 'Syne', sans-serif; }

    body::before {
      content: '';
      position: fixed; inset: 0; z-index: 0; pointer-events: none;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
      opacity: 0.35;
    }

    .hero-bg {
      background:
        radial-gradient(ellipse 70% 60% at 15% 50%, rgba(var(--accent-rgb),0.15) 0%, transparent 60%),
        radial-gradient(ellipse 50% 70% at 85% 20%, rgba(var(--accent-rgb),0.08) 0%, transparent 55%),
        #0d0d0d;
      transition: background 0.4s ease;
    }

    .glass {
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.09);
      backdrop-filter: blur(12px);
    }

    .glass-orange {
      background: rgba(var(--accent-rgb), 0.06);
      border: 1px solid rgba(var(--accent-rgb), 0.2);
      backdrop-filter: blur(12px);
      transition: background 0.3s ease, border-color 0.3s ease;
    }

    .nav-blur {
      background: rgba(13,13,13,0.8);
      backdrop-filter: blur(20px);
      border-bottom: 1px solid rgba(255,255,255,0.06);
    }

    .cta-glow:hover { box-shadow: 0 0 32px rgba(var(--accent-rgb),0.5); }
    .cta-glow-teal:hover { box-shadow: 0 0 32px rgba(20,184,166,0.5); }

    /* ── Reusable page-wide accent utilities (theme-aware) ── */
    .accent-text { color: var(--accent-500); transition: color 0.3s ease; }
    .accent-text-soft { color: var(--accent-400); transition: color 0.3s ease; }
    .accent-bg { background-color: var(--accent-500); transition: background-color 0.3s ease; }
    .accent-bg:hover { background-color: var(--accent-600); }
    .accent-badge {
      background-color: rgba(var(--accent-rgb), 0.1);
      border: 1px solid rgba(var(--accent-rgb), 0.3);
      color: var(--accent-400);
      transition: background-color 0.3s ease, border-color 0.3s ease, color 0.3s ease;
    }
    .accent-dot { background-color: var(--accent-400); transition: background-color 0.3s ease; }
    .accent-link { color: var(--accent-400); transition: color 0.25s ease; }
    .accent-link:hover { color: var(--accent-500); }
    .nav-link { transition: color 0.25s ease; }
    .nav-link:hover, .nav-link.is-active { color: var(--accent-400); }

    .reveal { opacity: 0; transform: translateY(28px); transition: opacity 0.7s ease, transform 0.7s ease; }
    .revealed { opacity: 1; transform: translateY(0); }

    .section-divider {
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(var(--accent-rgb),0.3), transparent);
      margin: 0 auto;
      width: 60%;
    }

    .test-card { transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease, opacity 0.35s ease; }
    .test-card:hover { transform: translateY(-3px); }

    .batch-tag {
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      padding: 3px 10px;
      border-radius: 999px;
    }

    .badge-blue { background: rgba(59,130,246,0.12); color: #93c5fd; border: 1px solid rgba(59,130,246,0.3); }
    .badge-teal { background: rgba(20,184,166,0.12); color: #5eead4; border: 1px solid rgba(20,184,166,0.3); }

    /* ── Tabs ── */
    .suite-tab-btn {
      transition: background 0.25s ease, color 0.25s ease, border-color 0.25s ease;
    }
    .suite-tab-btn[aria-selected="false"] {
      background: transparent;
      color: #d4d4d4;
      border-color: rgba(255,255,255,0.15);
    }
    .suite-tab-btn[data-tab="cat"][aria-selected="true"] {
      background: #f97316;
      color: #fff;
      border-color: #f97316;
    }
    .suite-tab-btn[data-tab="gmat"][aria-selected="true"] {
      background: #14b8a6;
      color: #fff;
      border-color: #14b8a6;
    }
    .suite-tab-btn[data-tab="cat"][aria-selected="false"]:hover {
      border-color: rgba(249,115,22,0.5);
      color: #fff;
    }
    .suite-tab-btn[data-tab="gmat"][aria-selected="false"]:hover {
      border-color: rgba(20,184,166,0.5);
      color: #fff;
    }

    /* ── Panel + card refresh transition on tab switch ── */
    .suite-panel[hidden] { display: none; }
    .suite-panel { transition: opacity 0.22s ease; }
    .suite-panel.panel-fading { opacity: 0; }
    .test-card.card-refresh-init {
      opacity: 0 !important;
      transform: translateY(14px) scale(0.98) !important;
      transition: opacity 0.35s ease, transform 0.35s ease !important;
    }
  </style>
</head>

<body class="relative overflow-x-hidden" data-theme="cat">

<!-- ══════════════════════════════
     NAVBAR
══════════════════════════════ -->
<nav id="navbar" class="fixed top-0 left-0 right-0 z-50 nav-blur">
  <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2">
      <span class="font-display text-2xl font-800 text-white tracking-tight">Edu<span class="accent-text">Shastra</span></span>
    </a>
    <ul class="hidden md:flex items-center gap-8 text-sm font-medium text-ink-200">
      <li><a href="https://www.edushastra.com/courses/" class="nav-link transition-colors">Courses</a></li>
      <li><a href="https://www.edushastra.com/cat-2026/#batches" class="nav-link transition-colors">Batches</a></li>
      <li><a href="https://www.edushastra.com/free-sectional-tests/" class="nav-link transition-colors">Sectional Tests</a></li>
      <li><a href="#practice" class="nav-link is-active">Daily Practice</a></li>
      <li><a href="#faqs" class="nav-link transition-colors">FAQs</a></li>
    </ul>
    <div class="flex items-center gap-3">
      <a href="https://www.edushastra.com/login/" class="hidden md:block text-sm text-ink-200 hover:text-white transition-colors px-4 py-2">Login</a>
      <a href="#practice" class="cta-glow accent-bg text-white text-sm font-semibold px-5 py-2.5 rounded-full transition-all duration-300">
        Start Today's Test →
      </a>
      <button id="menuBtn" class="md:hidden text-white p-1" aria-label="Menu">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
    </div>
  </div>
  <div id="mobileMenu" class="hidden md:hidden px-6 pb-6 pt-2 flex flex-col gap-4 text-sm font-medium text-ink-200">
    <a href="#practice">Daily Practice</a>
    <a href="https://www.edushastra.com/free-sectional-tests/">Sectional Tests</a>
    <a href="https://www.edushastra.com/cat-2026/#batches">Batches</a>
    <a href="#faqs">FAQs</a>
    <a href="https://www.edushastra.com/login/">Login</a>
  </div>
</nav>

<!-- ══════════════════════════════
     HERO
══════════════════════════════ -->
<section class="hero-bg relative min-h-[50vh] flex items-center pt-32 pb-12 px-6">
  <div class="max-w-7xl mx-auto w-full relative z-10">
    <div class="max-w-3xl">
      <div class="accent-badge inline-flex items-center gap-2 rounded-full px-4 py-1.5 text-xs font-semibold tracking-widest uppercase mb-6">
        <span class="accent-dot w-1.5 h-1.5 rounded-full animate-pulse"></span>
        100% Free · A New Test Every Day
      </div>

      <h1 class="font-display text-5xl md:text-6xl lg:text-7xl font-800 leading-[1.05] text-white mb-6">
        Free Daily<br/>
        <span class="accent-text">Practice Tests</span>
      </h1>

      <p class="text-lg text-ink-200 max-w-xl leading-relaxed mb-2">
       Sharpen your skills with Daily Practice Tests.<br>
       A short daily mini-mock to track your progress — for CAT or GMAT.
      </p>

      <div class="flex flex-wrap gap-3">
        <span class="glass rounded-full px-4 py-2 text-sm font-medium text-white">⏱️ 40 Minutes Total</span>
        <span class="glass rounded-full px-4 py-2 text-sm font-medium text-white">🧩 20 Mixed Questions</span>
        <span class="glass rounded-full px-4 py-2 text-sm font-medium text-white">📊 Daily Progress Tracking</span>
      </div>
    </div>
  </div>
</section>

<!-- ══════════════════════════════
     SECTION: EXAM TABS (CAT / GMAT) — centered
══════════════════════════════ -->
<section class="px-6 pt-10">
  <div class="max-w-7xl mx-auto flex justify-center">
    <div class="reveal inline-flex gap-2 p-1.5 rounded-full glass" role="tablist" aria-label="Choose your exam">
      <button
        type="button"
        id="tab-btn-cat"
        class="suite-tab-btn rounded-full px-6 py-2.5 text-sm font-semibold border"
        role="tab"
        aria-selected="true"
        aria-controls="tab-panel-cat"
        data-tab="cat"
      >
        CAT
      </button>
      <button
        type="button"
        id="tab-btn-gmat"
        class="suite-tab-btn rounded-full px-6 py-2.5 text-sm font-semibold border"
        role="tab"
        aria-selected="false"
        aria-controls="tab-panel-gmat"
        data-tab="gmat"
      >
        GMAT
      </button>
    </div>
  </div>
</section>

<!-- ══════════════════════════════
     DAILY PRACTICE GRID (auto-populated, last 6 days)
══════════════════════════════ -->
<section id="practice" class="py-12 px-6 scroll-mt-28">
  <div class="max-w-7xl mx-auto">

    <!-- CAT PANEL (blue/orange accent) -->
    <div id="tab-panel-cat" class="suite-panel" role="tabpanel" aria-labelledby="tab-btn-cat" data-panel="cat">
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {dailyCardSlots.map(offset => (
          <div class="reveal test-card glass rounded-3xl overflow-hidden hover:border-blue-400/30">
            <div class="h-1 bg-gradient-to-r from-blue-500 to-blue-400"></div>
            <div class="p-6">
              <span class="batch-tag badge-blue mb-3 inline-block daily-date" data-day-offset={offset}>—</span>
              <h3 class="font-display text-xl font-700 text-white mb-4">Daily Practice Test</h3>
              <div class="flex gap-3 text-xs mb-6">
                <div class="glass rounded-lg px-3 py-2 text-center flex-1">
                  <p class="font-display font-700 text-white">20</p>
                  <p class="text-ink-400 mt-0.5">Questions</p>
                </div>
                <div class="glass rounded-lg px-3 py-2 text-center flex-1">
                  <p class="font-display font-700 text-white">40 min</p>
                  <p class="text-ink-400 mt-0.5">Duration</p>
                </div>
              </div>
              <a href={TEST_LINK} class="block text-center bg-brand-500 hover:bg-brand-600 text-white text-sm font-semibold px-4 py-2.5 rounded-full transition-all cta-glow">
                Take Test →
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- GMAT PANEL (teal/cyan accent) -->
    <div id="tab-panel-gmat" class="suite-panel" role="tabpanel" aria-labelledby="tab-btn-gmat" data-panel="gmat" hidden>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {dailyCardSlots.map(offset => (
          <div class="reveal test-card glass rounded-3xl overflow-hidden hover:border-teal-400/30">
            <div class="h-1 bg-gradient-to-r from-teal-600 to-teal-400"></div>
            <div class="p-6">
              <span class="batch-tag badge-teal mb-3 inline-block daily-date" data-day-offset={offset}>—</span>
              <h3 class="font-display text-xl font-700 text-white mb-4">Daily Practice Test</h3>
              <div class="flex gap-3 text-xs mb-6">
                <div class="glass rounded-lg px-3 py-2 text-center flex-1">
                  <p class="font-display font-700 text-white">20</p>
                  <p class="text-ink-400 mt-0.5">Questions</p>
                </div>
                <div class="glass rounded-lg px-3 py-2 text-center flex-1">
                  <p class="font-display font-700 text-white">40 min</p>
                  <p class="text-ink-400 mt-0.5">Duration</p>
                </div>
              </div>
              <!-- GMAT LINK: replace GMAT_TEST_LINK above with real GMAT daily test URL -->
              <a href={GMAT_TEST_LINK} class="block text-center bg-teal-500 hover:bg-teal-600 text-white text-sm font-semibold px-4 py-2.5 rounded-full transition-all cta-glow-teal">
                Take Test →
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>

<!-- ══════════════════════════════
     HOW IT WORKS
══════════════════════════════ -->
<section class="py-16 px-6 bg-ink-800/20">
  <div class="max-w-7xl mx-auto">
    <div class="reveal mb-10 text-center">
      <h2 class="font-display text-4xl md:text-5xl font-800 text-white">
        Why a <span class="accent-text">Daily Sprint?</span>
      </h2>
    </div>
    <div class="grid md:grid-cols-3 gap-5">
      {[
        { icon: "🗓️", title: "One Test, Every Day", desc: "A new Daily Practice Test is uploaded each day, built to be finished in one focused sitting — no excuses to skip prep." },
        { icon: "🔁", title: "Catch Up Anytime", desc: "Missed a day or two? The last 6 days are always here, so you can attempt any of them whenever you get the time." },
        { icon: "📈", title: "Consistency Compounds", desc: "Short daily reps build the exam stamina and pacing instinct that one long weekly mock can't replicate on its own." },
      ].map(f => (
        <div class="reveal glass rounded-2xl p-6">
          <h4 class="accent-text font-display font-700 text-xl mb-3">{f.icon} {f.title}</h4>
          <p class="text-white text-sm leading-relaxed">{f.desc}</p>
        </div>
      ))}
    </div>

    <div class="reveal glass-orange rounded-3xl p-8 mt-10 flex flex-col md:flex-row items-center justify-between gap-6">
      <div>
        <p class="font-display font-700 text-white text-xl mb-1">Want a deeper diagnostic?</p>
        <p class="text-ink-200 text-sm">Try our full Sectional Tests across VARC, DILR and QA to isolate exactly where you're losing percentile.</p>
      </div>
      <a href="https://www.edushastra.com/free-sectional-tests/" class="accent-bg cta-glow text-white text-sm font-semibold px-6 py-3 rounded-full transition-all whitespace-nowrap">
        See Sectional Tests →
      </a>
    </div>
  </div>
</section>

<!-- ══════════════════════════════
     FAQs
══════════════════════════════ -->
<section id="faqs" class="py-16 px-6">
  <div class="max-w-4xl mx-auto">

    <div class="reveal mb-12 text-center">
      <p class="accent-text-soft text-xs font-semibold tracking-widest uppercase mb-3">Common Questions</p>
      <h2 class="font-display text-4xl font-800 text-white">Frequently Asked</h2>
    </div>

    <div class="space-y-3" id="faqList">
      {[
        { q: "How often is a new Daily Practice Test added?", a: "A new test is uploaded every day. The page always shows the most recent 6 days, so the list updates automatically as new tests go live." },
        { q: "Is the Daily Practice Test free?", a: "Yes — every Daily Practice Test is completely free to attempt, with no signup fee." },
        { q: "What if I miss a day?", a: "No problem — the last 6 days of tests stay available on this page, so you can go back and attempt any of them whenever you're free." },
        { q: "Do older tests disappear after 6 days?", a: "This page always shows a rolling window of the most recent 6 days. Older tests move out of this view as new ones are added, so it's best to attempt each test while it's still listed here." },
        { q: "How is this different from the Sectional Tests?", a: "Sectional Tests are 4 fixed, full-length mocks per section (VARC, DILR, QA) you can take anytime. Daily Practice Tests are shorter, change every day, and are meant as a quick daily habit rather than a complete sectional simulation." },
        { q: "Do I need to register to take a test?", a: "You'll need a free EduShastra account to save your attempts and track your progress over time. Creating one takes under a minute." },
        { q: "Is there a Daily Practice Test for GMAT too?", a: "Yes — use the CAT / GMAT toggle above the test grid to switch between the two. Each has its own rolling 6-day set of tests." },
      ].map((faq, i) => (
        <div class="reveal glass rounded-2xl overflow-hidden">
          <button class="faq-btn w-full text-left px-7 py-5 flex items-start justify-between gap-4 group" data-index={i}>
            <span class="font-display font-700 text-white text-sm leading-relaxed">{faq.q}</span>
            <span class="faq-icon accent-text-soft flex-shrink-0 mt-0.5 transition-transform duration-300 text-lg">+</span>
          </button>
          <div class="faq-body hidden px-7 pb-6">
            <p class="text-ink-200 text-sm leading-relaxed">{faq.a}</p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<!-- ══════════════════════════════
     FOOTER
══════════════════════════════ -->
<footer class="border-t border-white/06 bg-ink-900 pt-16 pb-8 px-6">
  <div class="max-w-7xl mx-auto">
    <div class="grid md:grid-cols-4 gap-12 mb-12">
      <div class="md:col-span-1 space-y-4">
        <p class="font-display text-2xl font-800 text-white">Edu<span class="accent-text">Shastra</span></p>
