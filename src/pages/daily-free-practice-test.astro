     JAVASCRIPT
══════════════════════════════ -->
<script>
  // Navbar scroll
  const navbar = document.getElementById('navbar');
  window.addEventListener('scroll', () => {
    navbar.style.background = window.scrollY > 80
      ? 'rgba(13,13,13,0.97)'
      : 'rgba(13,13,13,0.8)';
  });

  // Mobile menu
  document.getElementById('menuBtn').addEventListener('click', () => {
    document.getElementById('mobileMenu').classList.toggle('hidden');
  });

  // ── Fill in the last 6 days on the static Daily Practice cards ──
  // Cards themselves are real markup (see above); this only sets each
  // card's date label based on its data-day-offset, so today's card
  // shows today's date, yesterday's card shows yesterday's, etc.
  // Runs for BOTH the CAT and GMAT grids (hidden panels included).
  function formatDate(d) {
    return `${d.getMonth() + 1}/${d.getDate()}/${d.getFullYear()}`;
  }

  function fillDailyDates() {
    document.querySelectorAll('.daily-date').forEach(el => {
      const offset = parseInt(el.getAttribute('data-day-offset'), 10) || 0;
      const d = new Date();
      d.setDate(d.getDate() - offset);
      el.textContent = formatDate(d);
    });
  }

  fillDailyDates();

  // Scroll reveal (static sections)
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry, i) => {
      if (entry.isIntersecting) {
        setTimeout(() => entry.target.classList.add('revealed'), i * 60);
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.08 });
  document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

  // ── CAT / GMAT tab switcher with a small "refresh" transition ──
  // Also flips the whole page's accent theme (orange ↔ teal) via
  // document.body.dataset.theme, which every .accent-* / var(--accent-*)
  // rule above reads from.
  const tabButtons = document.querySelectorAll('.suite-tab-btn');
  const tabPanels = document.querySelectorAll('.suite-panel');
  let isSwitching = false;

  function showPanel(panel) {
    panel.hidden = false;
    panel.classList.remove('panel-fading');

    // Prime every card as "just off-screen", force a reflow, then let them
    // settle back into place one after another — reads as the grid refreshing.
    const cards = panel.querySelectorAll('.test-card');
    cards.forEach((c) => c.classList.add('card-refresh-init'));
    void panel.offsetWidth; // force reflow so the init state actually renders
    cards.forEach((c, i) => {
      setTimeout(() => c.classList.remove('card-refresh-init'), 40 + i * 45);
    });
  }

  function activateTab(tabName) {
    if (isSwitching) return;
    const currentPanel = document.querySelector('.suite-panel:not([hidden])');
    const nextPanel = document.querySelector(`.suite-panel[data-panel="${tabName}"]`);
    if (!nextPanel || nextPanel === currentPanel) return;

    isSwitching = true;
    tabButtons.forEach((btn) => {
      btn.setAttribute('aria-selected', btn.dataset.tab === tabName ? 'true' : 'false');
    });

    // Flip the page-wide accent theme immediately so everything outside
    // the grid (nav, hero, headings, buttons, footer, FAQ) transitions
    // in sync with the panel swap below.
    document.body.dataset.theme = tabName;

    if (currentPanel) {
      currentPanel.classList.add('panel-fading');
      setTimeout(() => {
        currentPanel.hidden = true;
        currentPanel.classList.remove('panel-fading');
        showPanel(nextPanel);
        isSwitching = false;
      }, 200);
    } else {
      showPanel(nextPanel);
      isSwitching = false;
    }
  }

  tabButtons.forEach((btn) => {
    btn.addEventListener('click', () => activateTab(btn.dataset.tab));
  });

  // FAQ accordion
  document.querySelectorAll('.faq-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const body = btn.nextElementSibling;
      const icon = btn.querySelector('.faq-icon');
      const isOpen = !body.classList.contains('hidden');

      document.querySelectorAll('.faq-body').forEach(b => b.classList.add('hidden'));
      document.querySelectorAll('.faq-icon').forEach(ic => { ic.textContent = '+'; ic.style.transform = 'rotate(0deg)'; });

      if (!isOpen) {
        body.classList.remove('hidden');
        icon.textContent = '−';
        icon.style.transform = 'rotate(0deg)';
      }
    });
  });
</script>

