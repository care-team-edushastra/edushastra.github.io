<!DOCTYPE html>
<html lang="en-IN" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{TITLE}</title>
  <meta name="description" content={DESCRIPTION} />
  <meta name="robots" content="index, follow, max-image-preview:large" />
  <link rel="canonical" href={PAGE_URL} />

  <!-- Open Graph -->
  <meta property="og:site_name" content="EduShastra" />
  <meta property="og:locale" content="en_IN" />
  <meta property="og:title" content={TITLE} />
  <meta property="og:description" content={DESCRIPTION} />
  <meta property="og:url" content={PAGE_URL} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content={OG_IMAGE} />
  <meta property="og:image:alt" content="EduShastra CAT 2027 online coaching – live online course" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={TITLE} />
  <meta name="twitter:description" content={DESCRIPTION} />
  <meta name="twitter:image" content={OG_IMAGE} />

  <!-- Reveal animation only hides content when JS is running -->
  <script is:inline>document.documentElement.classList.add('js');</script>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:ital,wght@0,400;0,500;1,300&display=swap" rel="stylesheet" />

  <!--
    PERF TODO: cdn.tailwindcss.com compiles CSS in the browser and is not meant for production.
    Once Tailwind is installed in the Astro project (npx astro add tailwind) and the config below is
    moved into tailwind.config.mjs, delete these two <script> tags.
  -->
  <script is:inline src="https://cdn.tailwindcss.com"></script>
  <script is:inline>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            display: ['Syne', 'sans-serif'],
            body: ['DM Sans', 'sans-serif'],
          },
          colors: {
            brand: {
              50:  '#f7ecd5',
              100: '#f0dcae',
              400: '#e3ab2b',
              500: '#e3ab2b',
              600: '#e3ab2b',
              700: '#e3ab2b',
            },
            ink: {
              900: '#0c1016',
              800: '#12161f',
              700: '#151a24',
              400: '#6b7284',
              200: '#a6adbb',
              100: '#eef0f4',
            }
          },
        }
      }
    }
  </script>

  {schemas.map((s) => (
    <script type="application/ld+json" is:inline set:html={JSON.stringify(s)} />
  ))}

  <style>
    :global(html) { scroll-padding-top: 5rem; }
    body { font-family: 'DM Sans', sans-serif; background: #0c1016; color: #eef0f4; }
    h1,h2,h3,h4,h5,.font-display { font-family: 'Syne', sans-serif; }

    body::before {
      content: '';
      position: fixed; inset: 0; z-index: 0; pointer-events: none;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
      opacity: 0.35;
    }

    .hero-bg {
      background:
        radial-gradient(ellipse 70% 60% at 15% 50%, rgba(227,171,43,0.15) 0%, transparent 60%),
        radial-gradient(ellipse 50% 70% at 85% 20%, rgba(227,171,43,0.08) 0%, transparent 55%),
        #0c1016;
    }

    .glass {
      background: #151a24;
      border: 1px solid rgba(255,255,255,0.09);
      backdrop-filter: blur(12px);
    }

    .glass-orange {
      background: rgba(227,171,43,0.06);
      border: 1px solid rgba(227,171,43,0.2);
      backdrop-filter: blur(12px);
    }

    .nav-blur {
      background: rgba(12,16,22,0.8);
      backdrop-filter: blur(20px);
      border-bottom: 1px solid rgba(255,255,255,0.06);
    }

    .cta-glow:hover { box-shadow: 0 0 32px rgba(227,171,43,0.5); }

    /* Scroll reveal: only hidden when JS is active (see .js class set in <head>) */
    .js .reveal { opacity: 0; transform: translateY(28px); transition: opacity 0.7s ease, transform 0.7s ease; }
    .js .reveal.revealed { opacity: 1; transform: translateY(0); }

    .no-scrollbar { scrollbar-width: none; -ms-overflow-style: none; }
