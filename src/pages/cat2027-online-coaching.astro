    /* ── Media scroller ── */
    .media-scroller {
      overflow: hidden;
      mask-image: linear-gradient(to right, transparent 0%, black 8%, black 92%, transparent 100%);
      -webkit-mask-image: linear-gradient(to right, transparent 0%, black 8%, black 92%, transparent 100%);
    }
    .media-track {
      display: flex;
      gap: 1.5rem;
      width: max-content;
      animation: marquee 40s linear infinite;
    }
    @keyframes marquee {
      0%   { transform: translateX(0); }
      100% { transform: translateX(-50%); }
    }
    .media-track:hover { animation-play-state: paused; }
    .media-card { flex: 0 0 280px; transition: border-color 0.3s ease, transform 0.3s ease; }
    .media-card:hover { transform: translateY(4px); }
    @media (prefers-reduced-motion: reduce) {
      .media-track { animation: none; }
      .media-scroller { overflow-x: auto; }
    }

    .badge-online  { background: rgba(73,199,184,0.15); color: #49c7b8; border: 1px solid rgba(73,199,184,0.3); }
