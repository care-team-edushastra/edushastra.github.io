<script is:inline>
  // Course selection: show only the chosen batch
  const sel = document.getElementById('planSelect');
  const panels = [...document.querySelectorAll('.plan-panel')];
  function show(id) {
    panels.forEach(p => p.hidden = p.dataset.id !== id);
    sel.value = id;
    try { history.replaceState(null, '', '#' + id); } catch (e) {}
  }
  sel.addEventListener('change', () => show(sel.value));
  const want = new URLSearchParams(location.search).get('plan') || location.hash.slice(1);
  show(panels.some(p => p.dataset.id === want) ? want : sel.dataset.default);

  // Payment tabs
  const tabs = [...document.querySelectorAll('[role=tab]')];
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => activate(t));
    t.addEventListener('keydown', e => {
      const n = e.key === 'ArrowRight' ? (i + 1) % tabs.length : e.key === 'ArrowLeft' ? (i - 1 + tabs.length) % tabs.length : null;
      if (n !== null) { tabs[n].focus(); activate(tabs[n]); }
    });
  });
  function activate(tab) {
    tabs.forEach(t => {
      const on = t === tab;
      t.setAttribute('aria-selected', String(on));
      document.getElementById(t.getAttribute('aria-controls')).hidden = !on;
    });
  }

  // Copy buttons
  document.querySelectorAll('.copy-btn').forEach(btn => btn.addEventListener('click', async () => {
    const old = btn.textContent;
    try { await navigator.clipboard.writeText(btn.dataset.copy); btn.textContent = 'Copied'; }
    catch (e) { btn.textContent = 'Copy failed'; }
    setTimeout(() => btn.textContent = old, 1500);
  }));
</script>
