---
const U = "https://www.edushastra.com";
// Course shown when the page opens without ?plan= or #id. Change this one value.
const DEFAULT_PLAN = "eliteplus-online";
type Plan = [id: string, mode: string, name: string, price: number, features: string[], apex: boolean];
const b: Record<string, string> = { Online:"badge-online", Classroom:"badge-offline", Hybrid:"badge-hybrid", Test:"badge-hybrid" };

// [id, mode, name, price, features, apex?]
const groups: [string, Plan[]][] = [
  ["Elite & Self-Paced", [
    ["self-paced","Online","Self-Paced Personalized Course",16999,["250+ Hours Course Cycle (Recorded)","24×7 Doubt Solving","Computer-Based & Adaptive Tests","Personalized Learning Experience","Valid for 6 Months"],false],
    ["test-series","Test","Elite Plus GMAT Test Series",2999,["100+ FL Mocks & Sectional Tests","Computer-Based & Adaptive Tests","AI-Based Performance Analytics","Valid for 6 Months"],false],
    ["elite-online","Online","Elite Live Online Course",18999,["250+ Hours Live Online & Recorded Classes","GMAT Course Material","Average Batch Size of 150 Students","Valid for 6 Months"],false],
  ]],
  ["Elite Plus", [
    ["eliteplus-online","Online","Elite Plus Live Online",28999,["250+ Hours Course Cycle","Audio, Video & Chat Interaction","Live In-class Doubt Solving","Average Batch Size of 30 Students","Valid for 6 Months"],false],
    ["eliteplus-classroom","Classroom","Elite Plus Classroom",42999,["250+ Hours Course Cycle","Personalized Learning Experience","Average Batch Size of 30 Students","Valid for 6 Months"],false],
    ["eliteplus-hybrid","Hybrid","Elite Plus Hybrid (Offline & Online)",44999,["250+ Hours Course Cycle","Personalized Learning Experience","Average Batch Size of 30 Students","Valid for 6 Months"],false],
  ]],
  ["+705 Apex-25", [
    ["apex-online","Online","+705 Apex-25 Live Online",39999,["500+ Hours Course Cycle","Audio, Video & Chat Interaction","Live 24×7 Doubt Solving","Average Batch Size of 25 Students","Lifetime Validity"],true],
    ["apex-classroom","Classroom","+705 Apex-25 Classroom (Offline)",49999,["500+ Hours Course Cycle","Personalized Learning Experience","Live 24×7 Doubt Solving","Average Batch Size of 25 Students","Lifetime Validity"],true],
    ["apex-hybrid","Hybrid","+705 Apex-25 Hybrid (Offline & Online)",51999,["500+ Hours Course Cycle","Audio, Video & Chat Interaction","Live 24×7 Doubt Solving","Average Batch Size of 25 Students","Lifetime Validity"],true],
  ]],
];
const allPlans: Plan[] = groups.flatMap(g => g[1]);

const apexSteps: [string, string][] = [
  ["Application Fee:","The fee to apply in the +705 Apex-25 batch is ₹29."],
  ["Post Fee Payment:","Email contact@edushastra.com with your Name, Email ID, Contact number and Course details."],
  ["Entrance Mapping Test:","A Mapping Test is sent after payment confirmation."],
  ["Enrollment Invite:","Selection is based on your Mapping Test and a review of academic records."],
];
const bank: [string, string, boolean][] = [
  ["Account Name","EduShastra Education Solutions Pvt. Ltd.",true],
  ["Account No.","018563400000373",true],
  ["Account Type","Current Account",false],
  ["Bank","Yes Bank",false],
  ["IFSC","YESB0000185",true],
  ["Branch","Meera Bagh, New Delhi — Ground Floor, B-379, Outer Ring Road, Delhi",false],
];
const crumbLd = JSON.stringify({
  "@context":"https://schema.org","@type":"BreadcrumbList",
  itemListElement:[
    {"@type":"ListItem",position:1,name:"Home",item:U},
    {"@type":"ListItem",position:2,name:"GMAT Coaching",item:`${U}/gmat-coaching/`},
    {"@type":"ListItem",position:3,name:"GMAT Courses Payment Portal",item:`${U}/gmat-course-payment-portal/`},
  ]
});
const fmt = (n: number) => "₹" + n.toLocaleString("en-IN");
