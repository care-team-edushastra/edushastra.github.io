const faqs = [
  ["What is the difference between Elite and Elite Plus course?", "Elite Plus has more personalized services than Elite: 1. Batch Size: Elite Plus batches average 25-30 students, while Elite batches have 150-200 students. 2. Class Interaction: Elite Plus classes are small enough for every student to regularly use the Audio, Video, Writing and Chatting controls. Elite classes offer Audio, Video and Chat interaction in larger batches. 3. Class Options: Elite Plus is available in Classroom, Live Online and Hybrid modes. Elite is available in Live Online mode only. 4. Course Validity: Both Elite and Elite Plus are valid for six months. Lifetime validity with repeated course cycles is part of the +705 Apex-25 batch only. 5. After GMAT Admission Counselling: In Elite Plus batches, after-exam services such as profile mapping, profile evaluation and help in college applications are provided."],
  ["What is the meaning of “Live Hybrid Course”?", "Hybrid Course is a combination of Live Online and Classroom Classes. A student can choose to take Classroom (Offline) or Live Online classes as per their convenience."],
  ["Are the Live Online classes interactive?", "Yes, the classes are interactive. The students can interact with the teacher through Audio, Video, Writing and Chatting controls."],
  ["What is +705 Apex-25 Batch?", "The Apex-25 Batch provides a unique learning environment with a small class size of 25 students, fostering individualized attention and deeper engagement. Students are selected based on merit through a comprehensive admission process. The students have to apply for the coveted seats in the Program. An admission test is conducted and students are selected on merit basis."],
  ["How many hours does one course cycle cover?", "One full GMAT course cycle in the Elite and Elite Plus courses has 250+ hours. The +705 Apex-25 course cycle has 500+ hours. Elite and Elite Plus are valid for six months, while Apex-25 has lifetime validity."],
  ["Do we get the recordings of the LIVE online interactive sessions?", "Yes, in Elite and Elite Plus course, class recordings are provided."],
  ["How many Tests are provided in the Elite Plus Batches?", "The test portal has Full-Length, Sectional and Topic-wise tests. Tests are computer-based and computer-adaptive. The Elite Plus Test Series includes 100+ full-length mocks and sectional tests."],
  ["Is the study material provided in this course?", "Yes, in Elite and Elite Plus course, Study materials are provided."],
  ["What is the average size of the batch?", "Elite Plus batches average 25-30 students. Elite batches have 150-200 students. Apex-25 batches have 25 students."],
  ["Are the repeated course cycles allowed?", "No. Elite and Elite Plus courses cover one course cycle and are valid for six months. Repeated course cycles with lifetime validity are available in the +705 Apex-25 batch."],
  ["Does Elite/Elite Plus course has a “Money-Back Guarantee”?", "The “Money-Back Guarantee” is provided in +705 Apex-25 Batch."],
  ["Is Application process included in the course?", "No, It is not provided in both Elite and Elite Plus course."],
];
const faqLd = JSON.stringify({
  "@context":"https://schema.org","@type":"FAQPage",
  mainEntity: faqs.map(([q,a]) => ({"@type":"Question",name:q,acceptedAnswer:{"@type":"Answer",text:a}}))
});
const portal = `${U}/gmat-courses-payment-portal/`;
const mk = (name, price, url, hours, extra={}) => ({
  "@type":"CourseInstance", name, courseMode:"online",
  ...(hours ? {courseWorkload:hours} : {}),
  availableAtOrFrom:{"@type":"VirtualLocation", url},
  offers:{"@type":"Offer", name, ...extra, price, priceCurrency:"INR", url, availability:"https://schema.org/InStock"}
});
const courseLd = JSON.stringify({
  "@context":"https://schema.org","@type":"Course",
  "@id":`${U}/gmat-coaching/#course`,
  name:"GMAT Live Coaching",
  description:"Live GMAT coaching with 100%ile faculty teaching in real time, IQ-based percentile batching across five Series, weekly adaptive evaluation tests, and a +705 fee-refund promise.",
  url:`${U}/gmat-coaching/`,
  provider:{"@type":"Organization",name:"EduShastra",sameAs:U,url:U},
  hasCourseInstance:[
    mk("Free Live Hybrid Course","0",`${U}/faq-gmat-free-course/`,"PT250H",{category:"Free"}),
    mk("Self-Paced Personalized","16999",portal,"PT250H"),
    mk("Elite Plus Test Series","2999",portal,null),
    mk("Elite Live Online Course","18999",portal,"PT250H"),
    mk("Elite Plus Live Online","28999",portal,"PT250H"),
    mk("Apex-25 Live Online","39999",`${U}/gmat-courses-payment-portal`,"PT500H"),
  ]
});
const crumbLd = JSON.stringify({
  "@context":"https://schema.org","@type":"BreadcrumbList",
  itemListElement:[
    {"@type":"ListItem",position:1,name:"Home",item:U},
    {"@type":"ListItem",position:2,name:"GMAT Coaching",item:`${U}/gmat-coaching/`},
  ]
});
