  ["Verbal Reasoning","Reading & Reasoning","Reading comprehension (4-5 passages) & critical reasoning. No sentence correction.","23 questions","badge-hybrid"],
  ["Data Insights","Data Analysis","Multi-source reasoning, table analysis, graphics interpretation. Calculator allowed.","20 questions","badge-offline"],
];
const batches = ["GMAT Focus Weekday Batch","GMAT Focus Weekend Batch","GMCAT Weekday Batch","GMCAT Weekend Batch"];
const media = [
  ["Ani News","ani-news.webp","26 New Centers by 2026: EduShastra Doubles National Footprint","https://www.aninews.in/news/business/edushastra-announces-strategic-national-expansion-26-new-coco-centers-to-launch-by-2026-following-record-breaking-2025-results20260406184910/"],
  ["Tribune India","tribune.webp","3 Lakh+ YouTube Subscribers: Outpacing India's Legacy Test-Prep Giants","https://www.tribuneindia.com/news/business/edushastra-announces-strategic-national-expansion-26-new-coco-centers-to-launch-by-2026-following-record-breaking-2025-results/"],
  ["Dailyhunt","dailyhunt.webp","IIM & IBS Alumni Leading: Meet the Highest-Rated Mentors in Indian Test Preparation","https://m.dailyhunt.in/news/india/english/ani+english-epaper-anieng/edushastra+announces+strategic+national+expansion+26+new+coco+centers+to+launch+by+2026+following+recordbreaking+2025+results-newsid-n707450317?"],
  ["Lokmat Times","Lokmat-1.webp","IQ-Mapped Batching: Only 5-Level Percentile Segregation System in India","https://www.lokmattimes.com/business/edushastra-announces-strategic-national-expansion-26-new-coco-centers-to-launch-by-2026-following-record-breaking-2025-results/"],
  ["Business Journal","Business-Journal.webp","Scientific Progression: Performance Benchmarks Replace Traditional Batching Methods","https://businessjournal.agency/edushastra-announces-strategic-national-expansion-26-new-coco-centers-to-launch-by-2026-following-record-breaking-2025-results/"],
  ["Maharashtra Samachar","Maharashtra.webp","Apex-25 Elite Batches: Hyper-Personalized Mentorship for Top Percentile Achievers.","https://www.maharashtrasamachar.com/news/edushastra-announces-strategic-national-expansion-26-new-coco-centers-to-launch-by-2026-following-record-breaking-2025-results20260406184907/"],
  ["Big News Network","Big-news-Network-e1775799817666.webp","Scientific Progression: Performance Benchmarks Replace Traditional Batching Methods","https://www.bignewsnetwork.com/news/278967341/edushastra-announces-strategic-national-expansion-26-new-coco-centers-to-launch-by-2026-following-record-breaking-2025-results#google_vignette"],
  ["Delhi Live News","Delhi-News.webp","Apex-25: Where Elite Meets Exclusive – Limited to 25 Toppers Only","https://www.lokmattimes.com/business/edushastra-announces-strategic-national-expansion-26-new-coco-centers-to-launch-by-2026-following-record-breaking-2025-results/"],
  ["Indian Economic Observer","Indian-economic.webp","EduShastra Announces Landmark Expansion: 26 New Centers to Double National Footprint by 2026","https://www.indianeconomicobserver.com/news/edushastra-announces-strategic-national-expansion-26-new-coco-centers-to-launch-by-2026-following-record-breaking-2025-results20260406184907/"],
  ["World News Network","world-news-network.webp","Competitive Learning Environments: How Homogeneous Batching Accelerates Progress","https://www.maharashtrasamachar.com/news/edushastra-announces-strategic-national-expansion-26-new-coco-centers-to-launch-by-2026-following-record-breaking-2025-results20260406184907/"],
