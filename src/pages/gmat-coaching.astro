<script is:inline>
  tailwind.config = { theme: { extend: {
    fontFamily: { display: ['Syne','sans-serif'], body: ['DM Sans','sans-serif'] },
    colors: {
      paper: '#FBF8F3',
      line:  '#E6DFD3',
      navy:  { 900:'#0B1730', 800:'#0F1F3D', 700:'#1B2F57', 600:'#34476B', 400:'#6B7A99', 100:'#E9EDF5' },
      accent:{ 400:'#F7B733', 500:'#F2A413', 600:'#D98B00', 700:'#9A5B00' },
    }
  }}}
</script>

<style>
  :root { --paper:#FBF8F3; --line:#E6DFD3; --navy:#0F1F3D; --accent:#F2A413; }
  body { font-family:'DM Sans',sans-serif; background:var(--paper); color:var(--navy); }
  h1,h2,h3,h4,h5,.font-display { font-family:'Syne',sans-serif; }
  :focus-visible { outline:3px solid #D98B00; outline-offset:3px; border-radius:6px; }

  .hero-bg {
    background:
      radial-gradient(ellipse 70% 60% at 15% 50%, rgba(242,164,19,0.12) 0%, transparent 60%),
      radial-gradient(ellipse 50% 70% at 85% 20%, rgba(15,31,61,0.06) 0%, transparent 55%),
      var(--paper);
  }

  .glass { background:rgba(255,255,255,0.65); border:1.5px solid rgba(15,31,61,0.22); backdrop-filter:blur(12px); box-shadow:0 2px 8px rgba(15,31,61,0.06); }
  .glass-orange { background:rgba(242,164,19,0.10); border:1.5px solid rgba(242,164,19,0.6); backdrop-filter:blur(12px); }
  .glass-dark { background:rgba(255,255,255,0.06); border:1.5px solid rgba(255,255,255,0.28); backdrop-filter:blur(12px); }

  .nav-blur { background:rgba(251,248,243,0.8); backdrop-filter:blur(20px); border-bottom:1.5px solid rgba(15,31,61,0.15); }

  .btn { background:var(--accent); color:var(--navy); font-weight:700; transition:background .2s ease, box-shadow .2s ease; }
  .btn:hover { background:#F7B733; }
  .cta-glow:hover { box-shadow:0 0 32px rgba(242,164,19,0.5); }
  .btn-ghost { border:1.5px solid var(--navy); color:var(--navy); transition:background .2s ease,color .2s ease; }
  .btn-ghost:hover { background:var(--navy); color:#fff; }
  .btn-ghost-dark { border:1.5px solid rgba(255,255,255,.5); color:#fff; transition:background .2s ease; }
  .btn-ghost-dark:hover { background:rgba(255,255,255,.12); }

  /* Content is visible by default; only hidden when JS is running */
  .js .reveal { opacity:0; transform:translateY(28px); transition:opacity .7s ease, transform .7s ease; }
  .js .reveal.revealed { opacity:1; transform:none; }

  .batch-tag { font-size:10px; font-weight:700; letter-spacing:.08em; text-transform:uppercase; padding:3px 10px; border-radius:999px; display:inline-block; }
  .tier-card { transition:transform .3s ease, border-color .3s ease; }
  .tier-card:hover { transform:translateY(-4px); }
  .badge-online  { background:#E6EEFB; color:#1E4FA3; border:1px solid #C5D6F2; }
  .badge-offline { background:#E5F4EA; color:#1F6B3A; border:1px solid #BFE2CB; }
  .badge-hybrid  { background:#EFE8FA; color:#5B3C99; border:1px solid #D8CBF0; }

  .table-row:nth-child(even) { background:rgba(15,31,61,0.025); }
  .yt-play { position:absolute; inset:0; margin:auto; width:3.5rem; height:3.5rem; display:grid; place-items:center; border-radius:9999px; background:rgba(12,16,22,.7); border:1px solid rgba(227,171,43,.5); color:#e3ab2b; font-size:1.25rem; transition:transform .2s ease, background .2s ease, color .2s ease; }
  .yt:hover .yt-play, .yt:focus-visible .yt-play { transform:scale(1.1); background:#e3ab2b; color:#0c1016; }
  .yt-frame { position:absolute; inset:0; width:100%; height:100%; border:0; }
  .table-row:hover { background:rgba(242,164,19,0.10); }

  .slider-track { display:flex; gap:1.5rem; }
  .media-scroller { overflow:hidden; mask-image:linear-gradient(to right,transparent 0%,black 8%,black 92%,transparent 100%); -webkit-mask-image:linear-gradient(to right,transparent 0%,black 8%,black 92%,transparent 100%); }
  .media-track { display:flex; gap:1.5rem; width:max-content; animation:marquee 40s linear infinite; }
  @keyframes marquee { 0%{transform:translateX(0)} 100%{transform:translateX(-50%)} }
  .media-track:hover { animation-play-state:paused; }
  .media-card { flex:0 0 280px; transition:border-color .3s ease, transform .3s ease; }
  .media-card:hover { transform:translateY(-4px); }

  /* FAQ (details/summary) */
  .faq summary { list-style:none; }
  .faq summary::-webkit-details-marker { display:none; }
  .faq .faq-icon::before { content:"+"; }
  .faq[open] .faq-icon::before { content:"−"; }

  @media (prefers-reduced-motion: reduce) {
    .js .reveal { opacity:1; transform:none; transition:none; }
    .media-track { animation:none; }
    .media-scroller { overflow-x:auto; }
    .tier-card, .media-card { transition:none; }
    html { scroll-behavior:auto; }
  }
</style>
</head>

