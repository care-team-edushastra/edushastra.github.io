<script is:inline>
  const navbar = document.getElementById('navbar');
  window.addEventListener('scroll', () => {
    navbar.style.background = window.scrollY > 80 ? 'rgba(251,248,243,0.97)' : 'rgba(251,248,243,0.8)';
  });

  const menuBtn = document.getElementById('menuBtn');
  menuBtn?.addEventListener('click', () => {
    const menu = document.getElementById('mobileMenu');
    menu.classList.toggle('hidden');
    menuBtn.setAttribute('aria-expanded', String(!menu.classList.contains('hidden')));
  });

  const io = new IntersectionObserver((entries) => {
    entries.forEach((e, i) => { if (e.isIntersecting) { setTimeout(() => e.target.classList.add('revealed'), i * 60); io.unobserve(e.target); } });
  }, { threshold: 0.08 });
  document.querySelectorAll('.reveal').forEach(el => io.observe(el));

  document.querySelectorAll('button.yt').forEach(btn => btn.addEventListener('click', () => {
    const f = document.createElement('iframe');
    f.className = 'yt-frame';
    f.src = 'https://www.youtube-nocookie.com/embed/' + btn.dataset.id + '?autoplay=1&rel=0';
    f.title = btn.dataset.title || 'Success story video';
    f.allow = 'autoplay; encrypted-media; picture-in-picture';
    f.allowFullscreen = true;
    btn.replaceWith(f);
  }));
</script>
