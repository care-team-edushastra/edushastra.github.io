  ["Online","Elite Plus Live Online","₹28,999","₹48,332",true,["250+ Hours Course Cycle","Audio, Video & Chat Interaction","Average Batch Size of 30 Students","Valid for Six Months"]],
  ["Classroom","Elite Plus Classroom","₹42,999","₹71,665",false,["250+ Hours Course Cycle","Personalized Learning Experience","Average Batch Size of 30 Students","Valid for Six Months"]],
  ["Hybrid","Elite Plus Hybrid Course","₹44,999","₹74,999",true,["250+ Hours Course Cycle","Personalized Learning Experience","Average Batch Size of 30 Students","Valid for Six Months"]],
];
