---
// EduShastra — Apex Study Suite Page (Astro)
// Matches CAT 2026 / Sectional Tests design: dark bg, orange accent, glassmorphism, Syne + DM Sans

// ── LINK CONFIG ───────────────────────────────────────────────────────────
// Every "Access Now" button defaults to FALLBACK_LINK. To point an individual
// resource somewhere else, just fill in its own URL below — leave it as
// FALLBACK_LINK to keep using the shared placeholder.
//
// NOTE: The GMAT tab links below are placeholders (edushastra.com/gmat-... /
// the same free login portal). Swap them for the real GMAT resource URLs
// once you have them — search "GMAT LINK:" to find every spot to edit.
//
// COLOR SCHEME: CAT panel keeps the orange "brand" accent. GMAT panel uses a
// teal/cyan accent (top bars, Access Now buttons, CTA glow, selected tab) so
// the two feel visually distinct at a glance. The rest of the page (nav,
// hero, CTA banner, footer) now follows the same accent via CSS variables
// tied to the selected tab — see the "Page-wide accent theme" block below.

---
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Free GMAT/CAT Coaching | Free GMAT/CAT 2026 Coaching Online - EduShastra</title>
  <link rel="icon" href="https://www.edushastra.com/wp-content/uploads/2024/09/eduShastra-logo_only-100x100.png" sizes="32x32"><link rel="icon" href="https://www.edushastra.com/wp-content/uploads/2024/09/eduShastra-logo_only-300x300.png" sizes="192x192">
  <meta name="description" content="Access EduShastra’s Apex Study Suite for free GMAT/CAT 2026 coaching online. Get 100%ile faculty video lectures, full-length mocks, daily practice tests, and comprehensive study material." />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href="https://www.edushastra.com/free-resources/" />

  <meta property="og:title" content="Free GMAT/CAT Coaching | Free GMAT/CAT 2026 Coaching Online - EduShastra" />
  <meta property="og:description" content="Access EduShastra’s Apex Study Suite for free GMAT/CAT 2026 coaching online. Get 100%ile faculty video lectures, full-length mocks, daily practice tests, and comprehensive study material." />
  <meta property="og:url" content="https://www.edushastra.com/free-resources/" />
  <meta property="og:type" content="website" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:ital,wght@0,300;0,400;0,500;1,300&display=swap" rel="stylesheet" />

  <script is:inline src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            display: ['Syne', 'sans-serif'],
            body: ['DM Sans', 'sans-serif'],
          },
          colors: {
            brand: {
              50:  '#fff7ed',
              100: '#ffedd5',
              400: '#fb923c',
              500: '#f97316',
              600: '#ea6c0a',
              700: '#c2540a',
            },
            ink: {
              900: '#0d0d0d',
              800: '#1a1a1a',
              700: '#2d2d2d',
              400: '#6b6b6b',
              200: '#d4d4d4',
              100: '#f5f5f5',
            }
          },
        }
      }
    }
  </script>

  <style>
    /* ── Page-wide accent theme ──
       Everything that should switch between CAT (orange) and GMAT (teal)
       reads from these variables instead of the fixed Tailwind "brand-*"
       colors. Toggled by setting data-theme="cat" | "gmat" on <body>. */
    :root {
      --accent-rgb: 249,115,22;
      --accent-100: #ffedd5;
      --accent-400: #fb923c;
      --accent-500: #f97316;
      --accent-600: #ea6c0a;
      --accent-700: #c2540a;
    }
    body[data-theme="gmat"] {
      --accent-rgb: 20,184,166;
      --accent-100: #ccfbf1;
      --accent-400: #5eead4;
      --accent-500: #14b8a6;
      --accent-600: #0d9488;
      --accent-700: #0f766e;
    }

    body { font-family: 'DM Sans', sans-serif; background: #0d0d0d; color: #f5f5f5; }
    h1,h2,h3,h4,h5,.font-display { font-family: 'Syne', sans-serif; }

    body::before {
      content: '';
      position: fixed; inset: 0; z-index: 0; pointer-events: none;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
      opacity: 0.35;
    }

    .hero-bg {
      background:
        radial-gradient(ellipse 70% 60% at 15% 50%, rgba(var(--accent-rgb),0.15) 0%, transparent 60%),
        radial-gradient(ellipse 50% 70% at 85% 20%, rgba(var(--accent-rgb),0.08) 0%, transparent 55%),
        #0d0d0d;
      transition: background 0.4s ease;
    }

    .glass {
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.09);
      backdrop-filter: blur(12px);
    }

    .glass-orange {
      background: rgba(var(--accent-rgb), 0.06);
      border: 1px solid rgba(var(--accent-rgb), 0.2);
      backdrop-filter: blur(12px);
      transition: background 0.3s ease, border-color 0.3s ease;
    }

    .nav-blur {
      background: rgba(13,13,13,0.8);
      backdrop-filter: blur(20px);
      border-bottom: 1px solid rgba(255,255,255,0.06);
    }

    .cta-glow:hover { box-shadow: 0 0 32px rgba(var(--accent-rgb),0.5); }
    .cta-glow-teal:hover { box-shadow: 0 0 32px rgba(20,184,166,0.5); }

    /* ── Reusable page-wide accent utilities (theme-aware) ── */
    .accent-text { color: var(--accent-500); transition: color 0.3s ease; }
    .accent-text-soft { color: var(--accent-400); transition: color 0.3s ease; }
    .accent-bg { background-color: var(--accent-500); transition: background-color 0.3s ease; }
    .accent-bg:hover { background-color: var(--accent-600); }
    .accent-badge {
      background-color: rgba(var(--accent-rgb), 0.1);
      border: 1px solid rgba(var(--accent-rgb), 0.3);
      color: var(--accent-400);
      transition: background-color 0.3s ease, border-color 0.3s ease, color 0.3s ease;
    }
    .accent-dot { background-color: var(--accent-400); transition: background-color 0.3s ease; }
    .accent-link { color: var(--accent-400); transition: color 0.25s ease; }
    .accent-link:hover { color: var(--accent-500); }
    .nav-link { transition: color 0.25s ease; }
    .nav-link:hover, .nav-link.is-active { color: var(--accent-400); }

    .reveal { opacity: 0; transform: translateY(28px); transition: opacity 0.7s ease, transform 0.7s ease; }
    .revealed { opacity: 1; transform: translateY(0); }

    .batch-tag {
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      padding: 3px 10px;
      border-radius: 999px;
    }

    .tier-card { transition: transform 0.3s ease, border-color 0.3s ease; }
    .tier-card:hover { transform: translateY(-4px); }

    .section-divider {
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(var(--accent-rgb),0.3), transparent);
      margin: 0 auto;
      width: 60%;
    }

    .badge-blue   { background: rgba(59,130,246,0.12);  color: #93c5fd; border: 1px solid rgba(59,130,246,0.3); }
    .badge-purple { background: rgba(168,85,247,0.12);  color: #d8b4fe; border: 1px solid rgba(168,85,247,0.3); }
    .badge-orange { background: rgba(249,115,22,0.12);  color: #fb923c; border: 1px solid rgba(249,115,22,0.3); }
    .badge-green  { background: rgba(34,197,94,0.12);   color: #86efac; border: 1px solid rgba(34,197,94,0.25); }
    .badge-teal   { background: rgba(20,184,166,0.12);  color: #5eead4; border: 1px solid rgba(20,184,166,0.3); }
    .badge-cyan   { background: rgba(34,211,238,0.12);  color: #67e8f9; border: 1px solid rgba(34,211,238,0.3); }

    .resource-card { transition: transform 0.3s ease, border-color 0.3s ease, opacity 0.35s ease; }
    .resource-card:hover { transform: translateY(-4px); }

    /* ── Tabs ── */
    .suite-tab-btn {
      transition: background 0.25s ease, color 0.25s ease, border-color 0.25s ease;
    }
    .suite-tab-btn[aria-selected="false"] {
      background: transparent;
      color: #d4d4d4;
      border-color: rgba(255,255,255,0.15);
    }
    .suite-tab-btn[data-tab="cat"][aria-selected="true"] {
      background: #f97316;
      color: #fff;
      border-color: #f97316;
    }
    .suite-tab-btn[data-tab="gmat"][aria-selected="true"] {
      background: #14b8a6;
      color: #fff;
      border-color: #14b8a6;
    }
    .suite-tab-btn[data-tab="cat"][aria-selected="false"]:hover {
      border-color: rgba(249,115,22,0.5);
      color: #fff;
    }
    .suite-tab-btn[data-tab="gmat"][aria-selected="false"]:hover {
      border-color: rgba(20,184,166,0.5);
      color: #fff;
    }

    /* ── Panel + card refresh transition on tab switch ── */
    .suite-panel[hidden] { display: none; }
    .suite-panel {
      transition: opacity 0.22s ease;
    }
    .suite-panel.panel-fading {
      opacity: 0;
    }
    .resource-card.card-refresh-init {
      opacity: 0 !important;
      transform: translateY(14px) scale(0.98) !important;
      transition: opacity 0.35s ease, transform 0.35s ease !important;
    }
  </style>
</head>

<body class="relative overflow-x-hidden" data-theme="cat">

