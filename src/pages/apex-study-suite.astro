<!-- ══════════════════════════════
     JAVASCRIPT
══════════════════════════════ -->
<script>
  // Navbar scroll
  const navbar = document.getElementById('navbar');
  window.addEventListener('scroll', () => {
    navbar.style.background = window.scrollY > 80
      ? 'rgba(13,13,13,0.97)'
      : 'rgba(13,13,13,0.8)';
  });

  // Mobile menu
  document.getElementById('menuBtn').addEventListener('click', () => {
    document.getElementById('mobileMenu').classList.toggle('hidden');
  });

  // Scroll reveal
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry, i) => {
      if (entry.isIntersecting) {
        setTimeout(() => entry.target.classList.add('revealed'), i * 60);
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.08 });
  document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

  // ── CAT / GMAT tab switcher with a small "refresh" transition ──
  // Also flips the whole page's accent theme (orange ↔ teal) via
  // document.body.dataset.theme, which every .accent-* / var(--accent-*)
  // rule above reads from.
  const tabButtons = document.querySelectorAll('.suite-tab-btn');
  const tabPanels = document.querySelectorAll('.suite-panel');
  let isSwitching = false;

  function showPanel(panel) {
    panel.hidden = false;
    panel.classList.remove('panel-fading');

    // Prime every card as "just off-screen", force a reflow, then let them
    // settle back into place one after another — reads as the grid refreshing.
    const cards = panel.querySelectorAll('.resource-card');
    cards.forEach((c) => c.classList.add('card-refresh-init'));
    void panel.offsetWidth; // force reflow so the init state actually renders
    cards.forEach((c, i) => {
      setTimeout(() => c.classList.remove('card-refresh-init'), 40 + i * 45);
    });
  }

  function activateTab(tabName) {
    if (isSwitching) return;
    const currentPanel = document.querySelector('.suite-panel:not([hidden])');
    const nextPanel = document.querySelector(`.suite-panel[data-panel="${tabName}"]`);
    if (!nextPanel || nextPanel === currentPanel) return;

    isSwitching = true;
    tabButtons.forEach((btn) => {
      btn.setAttribute('aria-selected', btn.dataset.tab === tabName ? 'true' : 'false');
    });

    // Flip the page-wide accent theme immediately so everything outside
    // the resource grid (nav, hero, CTA banner, footer) transitions in
    // sync with the panel swap below.
    document.body.dataset.theme = tabName;

    if (currentPanel) {
      currentPanel.classList.add('panel-fading');
      setTimeout(() => {
        currentPanel.hidden = true;
        currentPanel.classList.remove('panel-fading');
        showPanel(nextPanel);
        isSwitching = false;
      }, 200);
    } else {
      showPanel(nextPanel);
      isSwitching = false;
    }
  }

  tabButtons.forEach((btn) => {
    btn.addEventListener('click', () => activateTab(btn.dataset.tab));
  });
</script>

