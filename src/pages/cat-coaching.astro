    </div>
    <div class="glass rounded-3xl overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-sm min-w-[640px]">
          <caption class="sr-only">Comparison of Elite, Elite Plus and Apex-25 CAT batches</caption>
          <thead>
            <tr class="border-b border-white/10">
              <td class="px-6 py-5"></td>
              {compareHead.map(h => <th scope="col" class="text-left px-6 py-5 font-display font-700 text-white text-base">{h}</th>)}
            </tr>
          </thead>
          <tbody>
            {compareRows.map(([label, ...vals]) => (
              <tr class="border-b border-white/5 last:border-0 odd:bg-white/[0.02]">
                <th scope="row" class="text-left px-6 py-5 font-display font-700 text-brand-400">{label}</th>
                {vals.map(v => <td class="px-6 py-5 text-ink-200">{v}</td>)}
              </tr>
