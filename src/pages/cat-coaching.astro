// One Course per card in the "CAT courses" section (modes)
const modeMap: Record<string, string> = { "Online": "Online", "Live Online": "Online", "Classroom": "Onsite", "Classroom (Offline)": "Onsite", "Hybrid": "Blended" };
const courseLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "CAT coaching courses",
  "itemListElement": feeGroups.flatMap(g => g.cards).map((c, i) => ({
    "@type": "ListItem", "position": i + 1,
    "item": {
      "@type": "Course",
      "name": `${c.name} (${c.mode})`,
      "description": c.feats.join(". ") + ".",
      "url": `${U}${c.more}`,
      "provider": { "@type": "EducationalOrganization", "@id": orgId, "name": "EduShastra", "url": U },
      "hasCourseInstance": { "@type": "CourseInstance", "courseMode": modeMap[c.mode] },
      "offers": { "@type": "Offer", "price": c.price === "Free" ? "0" : c.price.replace(/[^\d]/g, ""), "priceCurrency": "INR", "url": c.join },
    },
  })),
};

// One Person per faculty card
