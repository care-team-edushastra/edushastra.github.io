<header class="hero-bg pt-32 pb-16 px-6">
  <div class="max-w-7xl mx-auto grid lg:grid-cols-2 gap-14 items-center">
    <div class="space-y-6">
      <nav aria-label="Breadcrumb" class="text-xs text-ink-200"><a href="https://www.edushastra.com/" class="hover:text-brand-400">Home</a> / CAT Coaching</nav>
      <h1 class="font-display text-5xl md:text-6xl font-800 leading-[1.05] text-white">CAT Coaching </h1>
            <a href="https://www.edushastra.com/adaptive-course-path-personalized-learning/">
        <h2 class="font-display text-[35px] md:text-[42px] lg:text-[48px] font-800 leading-[1.05] text-white"><span class="text-brand-500">5-Levels Percentile</span><br/>Based Batches</h2>
      </a>
