      <p class="text-ink-200 max-w-3xl mx-auto mt-4">Every course runs in four phases, each designed to feel as personal as one-on-one instruction.</p>
    </div>
    <ol class="grid md:grid-cols-2 lg:grid-cols-4 gap-5">
      {phases.map(([t, stage, d], i) => (
        <li class="glass rounded-2xl p-5">
          <span class="font-display text-4xl font-800 text-brand-500">{i + 1}</span>
