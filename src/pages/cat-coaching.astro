<script is:inline>
      document.querySelectorAll('button.yt').forEach(btn => btn.addEventListener('click', () => {
    const f = document.createElement('iframe');
    f.className = 'yt-frame';
    f.src = 'https://www.youtube-nocookie.com/embed/' + btn.dataset.id + '?autoplay=1&rel=0';
    f.title = btn.dataset.title || 'Success story video';
    f.allow = 'autoplay; encrypted-media; picture-in-picture';
    f.allowFullscreen = true;
    btn.replaceWith(f);
  }));
  document.querySelectorAll('.faq-btn').forEach(btn => btn.addEventListener('click', () => {
    const body = btn.nextElementSibling, open = !body.classList.contains('hidden');
    document.querySelectorAll('.faq-body').forEach(b => b.classList.add('hidden'));
    document.querySelectorAll('.faq-btn').forEach(b => { b.setAttribute('aria-expanded','false'); b.querySelector('.faq-icon').textContent = '+'; });
    if (!open) { body.classList.remove('hidden'); btn.setAttribute('aria-expanded','true'); btn.querySelector('.faq-icon').textContent = '−'; }
  }));
</script>
