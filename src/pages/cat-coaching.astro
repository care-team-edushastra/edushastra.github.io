                  <a href={`${U}${c.more}`} class="flex-1 text-center border border-brand-500/40 text-brand-400 text-xs font-semibold px-4 py-2.5 rounded-full hover:bg-brand-500/10">Explore</a>
                  <a href={c.join} data-plan={c.plan} class="btn flex-1 text-center text-xs font-semibold px-4 py-2.5 rounded-full">{c.cta}</a>
                </div>
