</section>

<section id="doubts" class="py-14 px-6">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-10">
      <h2 class="font-display text-4xl font-800 text-white">24/7 Doubt Connect Program</h2>
      <p class="text-ink-200 max-w-3xl mx-auto mt-4">Solving students' doubts and questions is our main priority. We provide the 24/7 Doubt Connect Program to all students.</p>
    </div>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {doubts.map(([t, d]) => (
