    </div>
    {feeGroups.map(g => (
      <div class="mb-12">
        <h3 class="font-display text-3xl font-800 text-white">{g.title} <span class="text-base font-body font-normal text-ink-400 ml-2">CAT 2027</span></h3>
        <p class="text-ink-200 text-base mt-1 mb-6">{g.sub}</p>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {g.cards.map(c => (
            <article class="lift glass rounded-3xl overflow-hidden flex flex-col">
              {c.hl && <div class="h-1 bg-gradient-to-r from-brand-500 to-brand-400"></div>}
              <div class="p-7 flex flex-col flex-1">
                <div class="flex justify-between items-start mb-4">
                  <div>
                    <span class={`batch-tag ${c.badge} mb-2 inline-block`}>{c.mode}</span>
                    <h4 class="font-display text-lg font-700 text-white">{c.name}</h4>
                  </div>
                  <div class="text-right">
