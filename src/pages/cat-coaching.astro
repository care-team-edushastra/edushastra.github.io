    </div>
    <div class="grid grid-cols-2 md:grid-cols-5 gap-4">
      {series.map(([n, p]) => (
        <div class="glass-gold rounded-2xl p-5 text-center">
          <p class="text-ink-200 text-sm">{n} batches</p>
          <p class="font-display text-3xl font-800 text-brand-500 my-1">{p}</p>
          <p class="text-ink-200 text-sm">percentile promise</p>
        </div>
      ))}
    </div>
    <p class="text-center mt-8"><a href="https://www.edushastra.com/faqs-money-back-promise/" class="text-brand-400 hover:text-brand-100 font-semibold text-sm">Read the full terms</a></p>
  </div>
</section>

<section id="counselling" class="py-14 px-6">
  <div class="max-w-7xl mx-auto">
