  </div>
</section>

<!-- EXAM PATTERN AND SYLLABUS -->
<section id="syllabus" class="py-14 px-6">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-10">
      <h2 class="font-display text-4xl font-800 text-white">CAT exam pattern and syllabus</h2>
      <p class="text-ink-200 max-w-3xl mx-auto mt-4 leading-relaxed">The last two CAT papers had 68 questions across three sections, to be solved in 120 minutes. Each section is timed at 40 minutes and locks when the time ends, so you cannot go back to it. The IIMs can change the pattern, so confirm the current one at iimcat.ac.in.</p>
    </div>
    <div class="grid md:grid-cols-3 gap-5">
      {examSections.map(s => (
        <article class="glass rounded-3xl p-7">
          <h3 class="font-display font-800 text-white text-2xl">{s.code}</h3>
          <p class="text-brand-400 text-sm font-semibold mt-1">{s.full}</p>
          <dl class="flex gap-3 mt-5 text-xs">
  {[[s.q, "Questions"], [s.time, "Time"], [s.marks, "Marks"]].map(([v, l]) => (
    <div class="glass-gold rounded-lg px-3 py-2 text-center flex flex-col-reverse">
      <dt class="text-ink-200 mt-0.5">{l}</dt>
      <dd class="font-display font-700 text-white text-base">{v}</dd>
    </div>
  ))}
</dl>
          <p class="text-ink-200 text-sm leading-relaxed mt-5">{s.about}</p>
          <h4 class="font-display font-700 text-white text-sm mt-5 mb-3">{s.code} topics</h4>
          <ul class="space-y-2 text-sm text-ink-200">
            {s.topics.map(t => (
              <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 bg-brand-500 rounded-full flex-shrink-0" aria-hidden="true"></span>{t}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>
    <p class="text-ink-200 text-sm leading-relaxed mt-6 max-w-4xl">Marking: +3 for every correct answer and −1 for every wrong multiple-choice answer. Typed-in answers (TITA) carry no negative marking. The paper is worth 204 marks in total.</p>
    <p class="mt-4"><a href="https://www.edushastra.com/cat-introduction/" class="text-brand-400 hover:text-brand-100 font-semibold text-sm">Full CAT exam details</a></p>
  </div>
</section>

<section id="cities" class="py-14 px-6">
