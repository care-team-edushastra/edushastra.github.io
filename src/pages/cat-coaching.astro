            <p class="text-ink-200 text-sm mt-2 mb-5 leading-relaxed">{c.sub}</p>
            <ul class="space-y-2 text-sm text-ink-200 mb-8">{c.feats.map(f => <li class="flex gap-2"><span class="text-brand-400" aria-hidden="true">✓</span> {f}</li>)}</ul>
            <a href={`${U}${c.href}`} class="btn mt-auto text-center text-sm font-semibold px-6 py-3 rounded-full">{c.cta}</a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<section id="compare" class="py-14 px-6">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-10">
      <h2 class="font-display text-4xl font-800 text-white">Elite vs Elite Plus vs Apex-25 batches</h2>
