          <div class="aspect-square bg-ink-800 overflow-hidden">
            <img src={`${U}/wp-content/uploads/${img}`} alt={`${name}, CAT coaching faculty at EduShastra`} class="w-full h-full object-cover object-top" loading="lazy" width="400" height="400" />
          </div>
          <div class="p-5">
            <p class="font-display font-700 text-white text-xl">{name}</p>
            <p class="text-brand-400 text-base font-semibold mt-1 mb-1.5">{cred}</p>
            <p class="text-ink-200 text-base leading-relaxed">{role}</p>
          </div>
        </div>
      ))}
    </div>
    <p class="text-center mt-8"><a href="https://www.edushastra.com/our-faculty-2/" class="glass hover:bg-white/10 text-ink-200 hover:text-white text-sm font-semibold px-8 py-3.5 rounded-full inline-block">Meet all faculty</a></p>
  </div>
