---
const U = "https://www.edushastra.com";
const PAGE = `${U}/cat-coaching/`;
const nextBatch = "10 November"; 

const modes = [
  { tag: "In person", title: "Classroom CAT Coaching", sub: "Study at one of six Delhi centres in weekday or weekend batches, morning or evening.",
    feats: ["Average batch size of about 30 students", "Elite, Elite Plus and Apex-25 batches", "Lifetime validity on Apex-25", "Classroom, live online or hybrid"],
    href: "/cat-2027-coaching/", cta: "See classroom batches" },
  { tag: "From home", title: "Online CAT Coaching", sub: "Live classes with the same four-phase course and the same teachers, wherever you are.",
    feats: ["Audio, video and chat interaction", "Live in-class doubt solving", "24x7 doubt solving on self-paced courses", "Free live hybrid course to try first"],
    href: "/cat-online-coaching/", cta: "See online batches" },
];
const phases = [
  ["Mapping Phase", "One-on-one", "Takes 2-4 sessions. Instructors assess every student in the batch. About 10% of course time."],
  ["Foundation Phase", "Batch", "Covers the basics of all CAT sections. About 20-50% of the course."],
  ["Testing Phase", "One-on-one", "Computer adaptive, computer based and paper based tests, with a minimum number of tests per course."],
  ["Control Phase", "One-on-one", "Closes the remaining gaps in your test preparation."],
];

const cities = [
  ["Delhi NCR", "/cat-coaching-delhi/"], ["Gurugram", "/cat-coaching-gurugram/"], ["Noida", "/cat-coaching-noida/"], ["Hyderabad", "/cat-coaching-hyderabad/"],
  ["Bengaluru", "/cat-coaching-bengaluru/"], ["Mumbai", "/cat2026-preparation-in-mumbai/"], ["Chennai", "/cat-coaching-chennai/"], ["Kolkata", "/cat-coaching-kolkata/"],
];

const faculty = [
  ["2023/08/M_L_Parashar.webp", "Mr. M L Parashar", "Formerly Director, Dept. of Science & Tech., Govt. of India", "Retired Deputy Secretary (Govt. of India) · IIM-Ahmedabad & IIT-Kanpur"],
  ["2025/09/Vipul-Parashar-EduShastra.webp", "Mr. Vipul Parashar", "99.99%ile in CAT 2024, 99.98%ile in CAT 2023, GMAT 780", "Over 12 years mentoring CAT and GMAT aspirants"],
  ["2025/02/ayush1.webp", "Mr. Ayush Matcha", "99.78%ile in CAT 2022 · IIM Class of 2023-25", "4+ years of classroom and online teaching experience"],
  ["2026/01/vibha-e1767786486545.webp", "Ms. Vibha Malhotra", "100th percentile in CAT Quant · GMAT Focus 745", "16+ years specializing in Quantitative Aptitude coaching"],
  ["2024/12/teachers007.webp", "Mr. Pawan Shahi", "99.92%ile in CAT 2024 · GMAT Focus 765", "NIT graduate and CAT topper turned full-time mentor"],
  ["2023/08/Deepak_Jain.webp", "Mr. Deepak Jain", "IIT & IIM alumnus · 100th percentile in CAT · GMAT 790", "Retired IAS officer with a UT administrative background"],
  ["2023/08/kushalbhardwaj.webp", "Dr. Kushal Bhardwaj", "Ph.D. from Delhi University · 99.99%ile CAT · GMAT 780", "16+ years in senior leadership across IT and retail"],
  ["2023/08/ankur-agarwal.webp", "Mr. Ankur Agarwal", "16+ years teaching in the test-prep industry", "Former Deputy Director at LPU with a strong scoring track record"],
];

const compareHead = ["Elite", "Elite Plus", "Apex-25"];
const compareRows = [
  ["Format", "Live classes + recordings", "Live: audio, video, writing and chat interaction", "Live, highly personalised"],
  ["Batch size", "150-200 students", "25-30 students", "25 students"],
  ["Doubt solving", "Weekly doubt sessions and forum", "In-class interaction plus weekly doubt sessions", "24x7 doubt solving"],
  ["Validity", "Till April 2028", "Till April 2028", "Lifetime"],
  ["Admission", "Open enrolment", "Open enrolment", "By Entrance Mapping Test and academic record review"],
];
const stories = [
  ["CAT Toppers",["sOzNln6QK7c","3zhfgyCW6VA","JgeR-90qgDg","YsOgM1qPZks"],"CAT topper story"],
  ["GMAT Toppers",["PRIHE2jnOrU","DRVo1r2Y4u4","Oox4aJVOHDE","7rO99uo3Og8"],"GMAT topper story"],  
  ["GMCAT Toppers",["gBOw4auB_zI","3golzQGiZtY","3_MvXZ3ydeY","FqC1bf-X9lA"],"GMCAT topper story"],
];
const doubts = [
  ["Discussion forum", "Get help from experts in real time on the 24/7 doubt and questions forum."],
  ["Highly interactive live sessions", "All classes are live, with audio, video, writing and chat controls. Students are encouraged to ask doubts in class."],
  ["Weekly doubt sessions", "Every subject teacher also runs a live doubt session each week."],
  ["Social media live groups", "Ask any query to experts in our social media groups."],
  ["Teachers panel contact details", "Every batch is handled by a panel of 7-9 teachers. Reach them by call, email, Skype and more."],
  ["Dedicated student support team", "Write to support@edushastra.com for any issue."],
];

const series = [
  ["6 series", "+60"], ["7 series", "+70"], ["8 series", "+80"], ["9 series", "+90"], ["10 series", "+99"],
];

const counselling = [
  "Profile evaluation based on IQ & EQ profile facets",
  "SNAP, XAT, IIFT, NMAT free course",
  "Soft skills & personal interview preparation",
  "Business school selection based on your profile strengths",
  "Profile mapping with targeted business schools",
  "Editing of Statements of Purpose, Letters of Recommendation, essays and resumes",
  "EduShastra alumni assistance & mentoring",
  "Comprehensive and rigorous interview preparation",
  "Educational loan and scholarship counselling",
];

const faqs = [
  ["What is CAT coaching?", "CAT coaching is structured preparation for the Common Admission Test, covering Quantitative Aptitude, Verbal Ability and Reading Comprehension, and Data Interpretation and Logical Reasoning, along with mock tests and doubt solving."],
  ["When is CAT 2026?", "CAT 2026 is on Sunday, 29 November 2026, conducted by IIM Indore. Always check iimcat.ac.in for the latest schedule."],
  ["Which is better: classroom or online CAT coaching?", "Both follow the same four-phase course. Choose classroom if you want to study at a Delhi centre, and online if you want live classes from home."],
  ["Do I need to prepare for the Mapping Test?", "No. It is an IQ-based test, not a knowledge test. It only decides which of the five groups you start in."],
  ["Is there a free way to start?", "Yes. The free live hybrid course gives you live classes, recordings and live in-class doubt solving."],
  ["How does the money-back promise work?", "Each batch group has its own percentile target, from +60 for 6-Series to +99 for 10-Series. Read the full terms on the Money-Back Promise page before you enrol."],
];

const faqLd = { "@context": "https://schema.org", "@type": "FAQPage", "mainEntity": faqs.map(([q, a]) => ({ "@type": "Question", "name": q, "acceptedAnswer": { "@type": "Answer", "text": a } })) };
const crumbLd = { "@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [
  { "@type": "ListItem", "position": 1, "name": "Home", "item": U },
  { "@type": "ListItem", "position": 2, "name": "CAT Coaching", "item": PAGE }] };
const orgLd = { "@context": "https://schema.org", "@type": "EducationalOrganization", "name": "EduShastra", "url": U, "telephone": "+91-11-47082205", "email": "contact@edushastra.com", "foundingDate": "2016" };
