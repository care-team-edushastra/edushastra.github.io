<style>
  body { font-family:'DM Sans',sans-serif; background:#0c1016; color:#eef0f4; }
  h1,h2,h3,h4,.font-display { font-family:'Syne',sans-serif; }
  :focus-visible { outline:3px solid #e3ab2b; outline-offset:3px; border-radius:6px; }
  .hero-bg { background: radial-gradient(ellipse 70% 60% at 15% 50%, rgba(227,171,43,.15) 0%, transparent 60%), #0c1016; }
  .glass { background:#151a24; border:1px solid rgba(255,255,255,.09); }
  .glass-gold { background:rgba(227,171,43,.06); border:1px solid rgba(227,171,43,.2); }
  .nav-blur { background:rgba(12,16,22,.85); backdrop-filter:blur(20px); border-bottom:1px solid rgba(255,255,255,.06); }
  .btn { background:#e3ab2b; color:#0c1016; transition:filter .2s ease; }
  .btn:hover { filter:brightness(1.1); }
  .tag { font-size:11px; font-weight:700; padding:3px 10px; border-radius:999px; display:inline-block; }
  .chip-on { background:rgba(227,171,43,.12); color:#e3ab2b; border:1px solid rgba(227,171,43,.25); }
  .yt-play { position:absolute; inset:0; margin:auto; width:3.5rem; height:3.5rem; display:grid; place-items:center; border-radius:9999px; background:rgba(12,16,22,.7); border:1px solid rgba(227,171,43,.5); color:#e3ab2b; font-size:1.25rem; transition:transform .2s ease, background .2s ease, color .2s ease; }
  .yt:hover .yt-play, .yt:focus-visible .yt-play { transform:scale(1.1); background:#e3ab2b; color:#0c1016; }
  .yt-frame { position:absolute; inset:0; width:100%; height:100%; border:0; }  
  .lift { transition:transform .3s ease, border-color .3s ease; } .lift:hover { transform:translateY(-3px); border-color:rgba(227,171,43,.5); }
  @media (prefers-reduced-motion: reduce) { .lift, .btn { transition:none; } .lift:hover { transform:none; } html { scroll-behavior:auto; } }
</style>
