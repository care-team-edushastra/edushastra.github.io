    "description": `${cred}. ${role}`,
    "worksFor": { "@type": "EducationalOrganization", "@id": orgId, "name": "EduShastra" },
  })),
};

const schemas = [orgLd, pageLd, crumbLd, faqLd, courseLd, peopleLd];
---
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{TITLE}</title>
<meta name="description" content={DESC} />
<meta name="robots" content="index, follow" />
<link rel="canonical" href={PAGE} />
<link rel="icon" href="https://www.edushastra.com/wp-content/uploads/2024/09/eduShastra-logo_only-100x100.png" sizes="32x32">

<!-- Open Graph -->
<meta property="og:title" content={TITLE} />
<meta property="og:description" content={DESC} />
<meta property="og:url" content={PAGE} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="EduShastra" />
<meta property="og:locale" content="en_IN" />
<meta property="og:image" content={OG_IMAGE} />
<meta property="og:image:alt" content={OG_IMAGE_ALT} />

<!-- Twitter / X card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={TITLE} />
<meta name="twitter:description" content={DESC} />
<meta name="twitter:image" content={OG_IMAGE} />
<meta name="twitter:image:alt" content={OG_IMAGE_ALT} />

<link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:ital,wght@0,300;0,400;0,500;1,300&display=swap" rel="stylesheet" />
{schemas.map(ld => (
  <script type="application/ld+json" set:html={JSON.stringify(ld)}></script>
))}
<script is:inline src="https://cdn.tailwindcss.com"></script>
<script is:inline>
  tailwind.config = { theme: { extend: {
    fontFamily: { display:['Syne','sans-serif'], body:['DM Sans','sans-serif'] },
    colors: {
      brand: { 50:'#f7ecd5', 100:'#f0dcae', 400:'#e3ab2b', 500:'#e3ab2b', 600:'#e3ab2b', 700:'#e3ab2b' },
      ink: { 900:'#0c1016', 800:'#12161f', 700:'#151a24', 400:'#6b7284', 200:'#a6adbb', 100:'#eef0f4' },
    }
  }}}
</script>
<style is:global>
  body { font-family:'DM Sans',sans-serif; background:#0c1016; color:#eef0f4; }
  h1,h2,h3,h4,.font-display { font-family:'Syne',sans-serif; }
  :focus-visible { outline:3px solid #e3ab2b; outline-offset:3px; border-radius:6px; }
  .hero-bg { background: radial-gradient(ellipse 70% 60% at 15% 50%, rgba(227,171,43,.15) 0%, transparent 60%), #0c1016; }
  .glass { background:#151a24; border:1px solid rgba(255,255,255,.09); }
  .glass-gold { background:rgba(227,171,43,.06); border:1px solid rgba(227,171,43,.2); }
  .nav-blur { background:rgba(12,16,22,.85); backdrop-filter:blur(20px); border-bottom:1px solid rgba(255,255,255,.06); }
  .btn { background:#e3ab2b; color:#0c1016; transition:filter .2s ease; }
  .btn:hover { filter:brightness(1.1); }
  .tag { font-size:11px; font-weight:700; padding:3px 10px; border-radius:999px; display:inline-block; }
  .chip-on { background:rgba(227,171,43,.12); color:#e3ab2b; border:1px solid rgba(227,171,43,.25); }
  .batch-tag { font-size:10px; font-weight:700; letter-spacing:.08em; text-transform:uppercase; padding:3px 10px; border-radius:999px; }
  .badge-online { background:rgba(73,199,184,.15); color:#49c7b8; border:1px solid rgba(73,199,184,.3); }
  .badge-offline { background:rgba(154,140,255,.12); color:#9a8cff; border:1px solid rgba(154,140,255,.25); }
  .badge-hybrid { background:rgba(227,171,43,.12); color:#e3ab2b; border:1px solid rgba(227,171,43,.25); }
  .yt-play { position:absolute; inset:0; margin:auto; width:3.5rem; height:3.5rem; display:grid; place-items:center; border-radius:9999px; background:rgba(12,16,22,.7); border:1px solid rgba(227,171,43,.5); color:#e3ab2b; font-size:1.25rem; transition:transform .2s ease, background .2s ease, color .2s ease; }
  .yt:hover .yt-play, .yt:focus-visible .yt-play { transform:scale(1.1); background:#e3ab2b; color:#0c1016; }
  .yt-frame { position:absolute; inset:0; width:100%; height:100%; border:0; }  
  .lift { transition:transform .3s ease, border-color .3s ease; } .lift:hover { transform:translateY(-3px); border-color:rgba(227,171,43,.5); }
  @media (prefers-reduced-motion: reduce) { .lift, .btn { transition:none; } .lift:hover { transform:none; } html { scroll-behavior:auto; } }
</style>
</head>
