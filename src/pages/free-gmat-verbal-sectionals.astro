---
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Free GMAT Verbal Sectional Tests | EduShastra</title>
  <link rel="icon" href="https://www.edushastra.com/wp-content/uploads/2024/09/eduShastra-logo_only-100x100.png" sizes="32x32"><link rel="icon" href="https://www.edushastra.com/wp-content/uploads/2024/09/eduShastra-logo_only-300x300.png" sizes="192x192">
  <meta name="description" content="Free GMAT Focus Edition Verbal Sectional Tests - Full-length mocks (45 min | 23 questions) as per GMAT pattern with Reading Comprehension, Critical Reasoning & instant analysis." />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href="https://www.edushastra.com/free-sectional-tests/gmat-verbal/" />

  <meta property="og:title" content="Free GMAT Verbal Sectional Tests | EduShastra" />
  <meta property="og:description" content="Free GMAT Focus Edition Verbal Sectional Tests - Full-length mocks (45 min | 23 questions) as per GMAT pattern with Reading Comprehension, Critical Reasoning & instant analysis." />
  <meta property="og:url" content="https://www.edushastra.com/free-sectional-tests/gmat-verbal/" />
  <meta property="og:type" content="website" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:ital,wght@0,300;0,400;0,500;1,300&display=swap" rel="stylesheet" />

  <script is:inline src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            display: ['Syne', 'sans-serif'],
            body: ['DM Sans', 'sans-serif'],
          },
          colors: {
            accent: {
              50:  '#ecfeff',
              100: '#cffafe',
              400: '#22d3ee',
              500: '#06b6d4',
              600: '#0891b2',
              700: '#0e7490',
            },
            brand: {
              500: '#f97316',
              600: '#ea6c0a',
            },
            ink: {
              900: '#0d0d0d',
              800: '#1a1a1a',
              700: '#2d2d2d',
              400: '#6b6b6b',
              200: '#d4d4d4',
              100: '#f5f5f5',
            }
          },
        }
      }
    }
  </script>

  <style>
    body { font-family: 'DM Sans', sans-serif; background: #0d0d0d; color: #f5f5f5; }
    h1,h2,h3,h4,h5,.font-display { font-family: 'Syne', sans-serif; }

    body::before {
      content: '';
      position: fixed; inset: 0; z-index: 0; pointer-events: none;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
      opacity: 0.35;
    }

    .hero-bg {
      background:
        radial-gradient(ellipse 70% 60% at 15% 50%, rgba(6,182,212,0.18) 0%, transparent 60%),
        radial-gradient(ellipse 50% 70% at 85% 20%, rgba(6,182,212,0.08) 0%, transparent 55%),
        #0d0d0d;
    }

    .glass {
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.09);
      backdrop-filter: blur(12px);
    }

    .glass-teal {
      background: rgba(6,182,212,0.06);
      border: 1px solid rgba(6,182,212,0.2);
      backdrop-filter: blur(12px);
    }

    .nav-blur {
      background: rgba(13,13,13,0.8);
      backdrop-filter: blur(20px);
      border-bottom: 1px solid rgba(255,255,255,0.06);
    }

    .cta-glow:hover { box-shadow: 0 0 32px rgba(6,182,212,0.45); }
    .cta-orange:hover { box-shadow: 0 0 32px rgba(249,115,22,0.5); }

    .reveal { opacity: 0; transform: translateY(28px); transition: opacity 0.7s ease, transform 0.7s ease; }
    .revealed { opacity: 1; transform: translateY(0); }

    .batch-tag {
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      padding: 3px 10px;
      border-radius: 999px;
    }

    .badge-teal { background: rgba(6,182,212,0.12); color: #67e8f9; border: 1px solid rgba(6,182,212,0.3); }
    .badge-orange { background: rgba(249,115,22,0.12); color: #fb923c; border: 1px solid rgba(249,115,22,0.3); }

    .test-card { transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease; }
    .test-card:hover { transform: translateY(-4px); border-color: rgba(6,182,212,0.35) !important; }

    /* topic chip */
    .topic-chip {
      font-size: 11px;
      font-weight: 500;
      color: #67e8f9;
      background: rgba(6,182,212,0.08);
      border: 1px solid rgba(6,182,212,0.2);
      border-radius: 999px;
      padding: 3px 10px;
      white-space: nowrap;
    }

    .progress-bar {
      height: 3px;
      border-radius: 999px;
      background: rgba(255,255,255,0.06);
      overflow: hidden;
    }
    .progress-fill {
      height: 100%;
      border-radius: 999px;
      background: linear-gradient(90deg, #06b6d4, #22d3ee);
    }
  </style>
</head>

<body class="relative overflow-x-hidden">

