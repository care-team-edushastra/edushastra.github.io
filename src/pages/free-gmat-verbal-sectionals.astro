      <p class="text-cyan-400 text-xs font-semibold tracking-widest uppercase mb-3">Common Questions</p>
      <h2 class="font-display text-4xl font-800 text-white">GMAT Verbal Test FAQs</h2>
    </div>
    <div class="space-y-3" id="faqList">
      {[
        { q: "Are these GMAT Verbal sectional tests free?", a: "Yes — all 4 Verbal tests are completely free with no signup fee. Click any 'Access Now' button to begin immediately." },
        { q: "Do I need to create an account?", a: "A free EduShastra account lets you save your scores and track improvement across attempts. It takes under a minute to create." },
        { q: "How is the Verbal section structured in the GMAT Focus Edition?", a: "Verbal runs for 45 minutes with 23 questions, split between Reading Comprehension and Critical Reasoning — there is no Sentence Correction in the Focus Edition. Our tests mirror this exact split." },
        { q: "Can I retake these tests?", a: "Yes, unlimited retakes. We recommend retaking after 2–3 weeks of focused study to measure genuine improvement." },
        { q: "Will I get explanations for wrong answers?", a: "Yes — every question includes a detailed solution and explanation immediately after submission, alongside your accuracy and time-per-question data." },
        { q: "What should I do after completing all 4 Verbal tests?", a: "Use your weakest question type to pick the right batch. Strong at RC but weak at CR? Our faculty-designed Verbal drills in the Elite batch target exactly that gap." },
      ].map((faq, i) => (
        <div class="reveal glass rounded-2xl overflow-hidden">
          <button class="faq-btn w-full text-left px-7 py-5 flex items-start justify-between gap-4" data-index={i}>
            <span class="font-display font-700 text-white text-sm leading-relaxed">{faq.q}</span>
            <span class="faq-icon text-cyan-400 flex-shrink-0 mt-0.5 transition-transform duration-300 text-lg">+</span>
