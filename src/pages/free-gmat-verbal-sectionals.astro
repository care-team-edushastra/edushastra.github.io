// EduShastra — GMAT Verbal Free Sectional Tests Page (Astro)
// Teal/Cyan accent | GMAT Focus Edition design system: dark bg, glassmorphism, Syne + DM Sans
const TEST_LINKS = [
  "https://edushastra-free.onrender.com/",
  "https://edushastra-free.onrender.com/",
  "https://edushastra-free.onrender.com/",
  "https://edushastra-free.onrender.com/",
