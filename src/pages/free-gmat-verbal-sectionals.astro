        Full-length Verbal mocks built to the exact GMAT Focus Edition pattern. Sharpen your Reading Comprehension and Critical Reasoning — one section at a time.
      </p>

      <div class="flex flex-wrap gap-3 mb-10">
        <span class="glass rounded-full px-4 py-2 text-sm font-medium text-white">⏱️ 45 Minutes</span>
        <span class="glass rounded-full px-4 py-2 text-sm font-medium text-white">📝 23 Questions</span>
        <span class="glass rounded-full px-4 py-2 text-sm font-medium text-white">📊 Instant Score & Analysis</span>
      </div>

      <a href="#tests" class="inline-block cta-glow bg-cyan-500 hover:bg-cyan-600 text-white font-semibold px-8 py-3.5 rounded-full transition-all duration-300 text-base">
        Jump to Tests ↓
      </a>
    </div>

    <!-- Stats card -->
    <div class="glass-teal rounded-3xl p-8 space-y-6 hidden lg:block">
      <p class="font-display font-700 text-white text-lg mb-2">What's tested in Verbal?</p>
      {[
        { label: "Reading Comprehension", pct: 52, note: "3–4 passages, multi-part questions" },
        { label: "Critical Reasoning", pct: 48, note: "Argument analysis & inference" },
      ].map(t => (
        <div>
          <div class="flex justify-between text-sm mb-1.5">
            <span class="text-ink-200">{t.label}</span>
            <span class="text-cyan-400 font-semibold">{t.pct}%</span>
          </div>
          <div class="progress-bar"><div class="progress-fill" style={`width:${t.pct}%`}></div></div>
          <p class="text-ink-400 text-xs mt-1">{t.note}</p>
        </div>
      ))}
