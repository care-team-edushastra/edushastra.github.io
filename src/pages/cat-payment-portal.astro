---
const U = "https://www.edushastra.com";
// Course shown when the page opens without ?plan= or #id. Change this one value.
const DEFAULT_PLAN = "eliteplus-online";
type Plan = [id: string, mode: string, name: string, price: number, features: string[], apex: boolean];
const b: Record<string, string> = { Online:"badge-online", Classroom:"badge-offline", Hybrid:"badge-hybrid", Test:"badge-hybrid" };

// [id, mode, name, price, features, apex?]
const groups: [string, Plan[]][] = [
  ["Elite & Self-Paced", [
    ["self-paced","Online","Self-Paced Personalized Course",16999,["500+ Hours Course Cycle (Recorded)","24×7 Doubt Solving","Computer-Based & Adaptive Tests","Personalized Learning Experience","Validity till April 2028"],false],
    ["test-series","Test","Elite Plus CAT Test Series",2999,["500+ FL Mocks & Sectional Tests","Full-Length & Sectional Tests","Computer-Based & Adaptive Tests","AI-Based Computer-Adaptive Tests","Valid for 1 Year"],false],
    ["elite-online","Online","Elite Live Online Course",18999,["500+ Hours Live Online & Recorded Classes","CAT Course Material","Average Batch Size of 150 Students","Validity till April 2028"],false],
  ]],
  ["Elite Plus", [
    ["eliteplus-online","Online","Elite Plus Live Online",28999,["500+ Hours Course Cycle","Audio, Video & Chat Interaction","Live In-class Doubt Solving","Average Batch Size of 30 Students","Validity till April 2028"],false],
    ["eliteplus-classroom","Classroom","Elite Plus Classroom",42999,["500+ Hours Course Cycle","Personalized Learning Experience","Average Batch Size of 30 Students","Validity till April 2028"],false],
    ["eliteplus-hybrid","Hybrid","Elite Plus Hybrid (Offline & Online)",44999,["500+ Hours Course Cycle","Personalized Learning Experience","Average Batch Size of 30 Students","Validity till April 2028"],false],
  ]],
  ["+99%ile Apex-25", [
    ["apex-online","Online","+99%ile Apex-25 Live Online",39999,["500+ Hours Course Cycle","Audio, Video & Chat Interaction","Live 24×7 Doubt Solving","Average Batch Size of 25 Students","Lifetime Validity"],true],
    ["apex-classroom","Classroom","+99%ile Apex-25 Classroom (Offline)",49999,["500+ Hours Course Cycle","Personalized Learning Experience","Live 24×7 Doubt Solving","Average Batch Size of 25 Students","Lifetime Validity"],true],
    ["apex-hybrid","Hybrid","+99%ile Apex-25 Hybrid (Offline & Online)",51999,["500+ Hours Course Cycle","Audio, Video & Chat Interaction","Live 24×7 Doubt Solving","Average Batch Size of 25 Students","Lifetime Validity"],true],
  ]],
];
const allPlans: Plan[] = groups.flatMap(g => g[1]);

const apexSteps: [string, string][] = [
  ["Application Fee:","The fee to apply in the +99%ile Apex-25 batch is ₹29."],
  ["Post Fee Payment:","Email contact@edushastra.com with your Name, Email ID, Contact number and Course details."],
  ["Entrance Mapping Test:","A Mapping Test is sent after payment confirmation."],
  ["Enrollment Invite:","Selection is based on your Mapping Test and a review of academic records."],
];
const bank: [string, string, boolean][] = [
  ["Account Name","EduShastra Education Solutions Pvt. Ltd.",true],
  ["Account No.","018563400000373",true],
  ["Account Type","Current Account",false],
  ["Bank","Yes Bank",false],
  ["IFSC","YESB0000185",true],
  ["Branch","Meera Bagh, New Delhi — Ground Floor, B-379, Outer Ring Road, Delhi",false],
];
const crumbLd = JSON.stringify({
  "@context":"https://schema.org","@type":"BreadcrumbList",
  itemListElement:[
    {"@type":"ListItem",position:1,name:"Home",item:U},
    {"@type":"ListItem",position:2,name:"CAT Coaching",item:`${U}/cat-2027-coaching`},
    {"@type":"ListItem",position:3,name:"CAT 2027 Payment Portal",item:`${U}/cat-payment-portal/`},
  ]
});
const fmt = (n: number) => "₹" + n.toLocaleString("en-IN");
